<Window x:Class="GUI_WPF.Pages.Bookings.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:GUI_WPF.UserControls.Cards"
        mc:Ignorable="d"
        Title="Booking Details"
        Width="1280"
        Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8F6F4">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Style="{StaticResource GlassCardStyle}"
                Padding="24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="txtBookingCode"
                               Style="{StaticResource CardTitleStyle}"
                               FontSize="28"
                               Text="BK-000001"/>

                    <TextBlock x:Name="txtBookingDate"
                               Margin="0,6,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="15 Sep 2026"/>

                </StackPanel>

                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        Padding="18,8"
                        CornerRadius="14"
                        VerticalAlignment="Top">

                    <TextBlock x:Name="txtStatus"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                </Border>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- TABS -->
        <!-- ================================================= -->

        <TabControl Grid.Row="1"
                    Margin="0,20,0,20">

            <!-- ============================================= -->
            <!-- OVERVIEW -->
            <!-- ============================================= -->

            <TabItem Header="Overview">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="12">

                        <!-- GUEST -->

                        <Border Style="{StaticResource SectionCardStyle}"
                                Margin="0,0,0,16"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Guest Information"
                                           Style="{StaticResource CardTitleStyle}"/>

                                <Grid Margin="0,18,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="90"
                                            Height="90"
                                            CornerRadius="45"
                                            ClipToBounds="True">

                                        <Image x:Name="imgGuest"/>

                                    </Border>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock x:Name="txtGuestName"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="txtGuestEmail"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                        <TextBlock x:Name="txtGuestPhone"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                        <TextBlock x:Name="txtGuestCountry"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- LISTING -->

                        <Border Style="{StaticResource SectionCardStyle}"
                                Margin="0,0,0,16"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Listing Information"
                                           Style="{StaticResource CardTitleStyle}"/>

                                <Grid Margin="0,18,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Height="170"
                                            CornerRadius="18"
                                            ClipToBounds="True">

                                        <Image x:Name="imgListing"
                                               Stretch="UniformToFill"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="20,0,0,0">

                                        <TextBlock x:Name="txtListingTitle"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="txtListingType"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                        <TextBlock x:Name="txtArea"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                        <TextBlock x:Name="txtAddress"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource BodyTextStyle}"/>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- STAY INFO -->

                        <Border Style="{StaticResource SectionCardStyle}"
                                Margin="0,0,0,16"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Stay Information"
                                           Style="{StaticResource CardTitleStyle}"/>

                                <UniformGrid Columns="4"
                                             Margin="0,16,0,0">

                                    <StackPanel>
                                        <TextBlock Text="Check In"
                                                   Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="txtCheckIn"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Check Out"
                                                   Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="txtCheckOut"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Guests"
                                                   Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="txtGuests"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="Nights"
                                                   Style="{StaticResource CaptionStyle}"/>
                                        <TextBlock x:Name="txtNights"/>
                                    </StackPanel>

                                </UniformGrid>

                                <TextBlock Text="Special Requests"
                                           Margin="0,18,0,0"
                                           Style="{StaticResource CaptionStyle}"/>

                                <TextBlock x:Name="txtSpecialRequests"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- PRICING -->

                        <Border Style="{StaticResource SectionCardStyle}"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Pricing Summary"
                                           Style="{StaticResource CardTitleStyle}"/>

                                <Grid Margin="0,16,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Price / Night"/>
                                    <TextBlock x:Name="txtPricePerNight"
                                               Grid.Column="1"/>

                                    <TextBlock Grid.Row="1"
                                               Text="Total Price"/>
                                    <TextBlock x:Name="txtTotalPrice"
                                               Grid.Row="1"
                                               Grid.Column="1"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Discount"/>
                                    <TextBlock x:Name="txtDiscount"
                                               Grid.Row="2"
                                               Grid.Column="1"/>

                                    <TextBlock Grid.Row="3"
                                               Text="Cleaning Fee"/>
                                    <TextBlock x:Name="txtCleaningFee"
                                               Grid.Row="3"
                                               Grid.Column="1"/>

                                    <TextBlock Grid.Row="4"
                                               Text="Service Fee"/>
                                    <TextBlock x:Name="txtServiceFee"
                                               Grid.Row="4"
                                               Grid.Column="1"/>

                                    <TextBlock Grid.Row="5"
                                               Text="Tax"/>
                                    <TextBlock x:Name="txtTax"
                                               Grid.Row="5"
                                               Grid.Column="1"/>

                                    <Separator Grid.Row="6"
                                               Grid.ColumnSpan="2"
                                               Margin="0,8"/>

                                </Grid>

                                <TextBlock x:Name="txtFinalPrice"
                                           Margin="0,16,0,0"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <!-- ============================================= -->
            <!-- NIGHTS -->
            <!-- ============================================= -->

            <TabItem Header="Nights">

                <ScrollViewer>

                    <StackPanel x:Name="spNights"
                                Margin="20"/>

                </ScrollViewer>

            </TabItem>

            <!-- ============================================= -->
            <!-- TIMELINE -->
            <!-- ============================================= -->

            <TabItem Header="Timeline">

                <ScrollViewer>

                    <StackPanel x:Name="spTimeline"
                                Margin="20"/>

                </ScrollViewer>

            </TabItem>

            <!-- ============================================= -->
            <!-- PAYMENT -->
            <!-- ============================================= -->

            <TabItem Header="Payment">

                <ScrollViewer>

                    <StackPanel Margin="20">

                        <Border Style="{StaticResource SectionCardStyle}"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="Transaction"
                                           Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock x:Name="txtTransactionCode"
                                           Margin="0,16,0,0"/>

                                <TextBlock x:Name="txtTransactionDate"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtTransactionAmount"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtGatewayReturn"
                                           Margin="0,8,0,0"/>

                                <TextBlock x:Name="txtPaymentStatus"
                                           Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

        </TabControl>

        <!-- FOOTER -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Close"
                    Style="{StaticResource OutlineButtonStyle}"
                    Click="btnClose_Click"/>

            <Button x:Name="btnConfirm"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Content="Confirm"
                    Style="{StaticResource SuccessButtonStyle}"
                    Click="btnConfirm_Click"/>

            <Button x:Name="btnCheckIn"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Content="Check-In"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="btnCheckIn_Click"/>

            <Button x:Name="btnCheckOut"
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    Content="Check-Out"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="btnCheckOut_Click"/>

            <Button x:Name="btnCancel"
                    Grid.Column="4"
                    Margin="10,0,0,0"
                    Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnRefund"
                    Grid.Column="5"
                    Margin="10,0,0,0"
                    Content="Refund"
                    Style="{StaticResource OutlineButtonStyle}"
                    Click="btnRefund_Click"/>

        </Grid>

    </Grid>

</Window>
<Window x:Class="GUI_WPF.Pages.Bookings.CreateBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cards="clr-namespace:GUI_WPF.UserControls.Cards"
        xmlns:common="clr-namespace:GUI_WPF.UserControls.Common"
        mc:Ignorable="d"
        Title="Create Manual Booking"
        Width="1420"
        Height="980"
        Background="#F8F6F4"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel Margin="0,0,0,40">

                <!-- HEADER -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="28" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Create Manual Booking" 
                                   Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Create booking for walk-in guests, phone reservations and direct reservations."
                                   Margin="0,8,0,0"
                                   Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- GUEST SECTION -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Guest Information" 
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <Button Grid.Column="1" 
                                    Content="+ New Guest"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="btnNewGuest_Click"/>
                        </Grid>

                        <!-- SearchBox tái sử dụng -->
                        <common:SearchBox x:Name="searchGuest" 
                                          Margin="0,20,0,12"
                                          Placeholder="Search guest by name, email or phone..."
                                          Height="52"/>

                        <DataGrid x:Name="dgGuests"
                                  Height="240"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  RowStyle="{StaticResource SoftRowStyle}"
                                  ColumnHeaderStyle="{StaticResource SoftColumnHeaderStyle}"
                                  CellStyle="{StaticResource SoftCellStyle}"
                                  AutoGenerateColumns="False"
                                  SelectionChanged="dgGuests_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="2*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Selected Guest -->
                        <Grid Margin="0,16,0,0">
                            <common:EmptyState
                                    x:Name="GuestEmptyState"
                                    Icon="👤"
                                    Title="No Guest Selected"
                                    Description="Select an existing guest or create a new one."/>

                            <Border x:Name="SelectedGuestPanel"
                                    Visibility="Collapsed"
                                    Background="#F7F4F2"
                                    CornerRadius="16"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="Selected Guest"
                                                FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtSelectedGuest"/>
                                </StackPanel>

                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LISTING SECTION -->

                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Select Listing" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cbArea" Style="{StaticResource ModernComboBoxStyle}"/>
                            <ComboBox x:Name="cbItemType" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ModernComboBoxStyle}"/>
                            <TextBox x:Name="txtCapacity" Grid.Column="2" Margin="12,0,0,0" 
                                     Style="{StaticResource SoftTextBoxStyle}" 
                                     Height="46" VerticalContentAlignment="Center"/>
                        </Grid>
                        <common:SearchBox
                                x:Name="searchListing"
                                Placeholder="Search listing title..."
                            />
                        <ScrollViewer Margin="0,24,0,0" Height="420" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="wpListings"/>

                        </ScrollViewer>
                        <Grid Margin="0,16,0,0">

                            <common:EmptyState
                                    x:Name="ListingEmptyState"
                                    Icon="🏡"
                                    Title="No Listing Selected"
                                    Description="Select a listing from above."/>

                            <Border x:Name="SelectedListingPanel"
                                    Visibility="Collapsed"
                                    Background="#F7F4F2"
                                    CornerRadius="16"
                                    Padding="20">

                                <StackPanel>
                                    <TextBlock Text="Selected Listing"
                       FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtSelectedListing"/>
                                </StackPanel>

                            </Border>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STAY INFORMATION -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Stay Information" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Check-in" Style="{StaticResource CaptionStyle}"/>
                                <DatePicker x:Name="dpCheckIn" Style="{StaticResource SoftDatePickerStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Check-out" Style="{StaticResource CaptionStyle}"/>
                                <DatePicker x:Name="dpCheckOut" Style="{StaticResource SoftDatePickerStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Number of Guests" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="txtGuests" Style="{StaticResource SoftTextBoxStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Cancellation Policy" Style="{StaticResource CaptionStyle}"/>
                                <ComboBox x:Name="cbPolicy" Style="{StaticResource ModernComboBoxStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Special Requests / Notes" 
                                   Margin="0,28,0,8" 
                                   Style="{StaticResource CaptionStyle}"/>
                        <TextBox x:Name="txtSpecialRequests" 
                                 Style="{StaticResource SoftTextAreaStyle}"
                                 Height="110"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 24, 0, 0">
                            <Button Content="Check Availability &amp; Pricing" 
                                    Width="260"
                                    Margin="0,24,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="btnCheckAvailability_Click"/>
                            <common:StatusChip
                                    x:Name="AvailabilityChip"
                                    Margin="16,0,0,0"
                                    Text="Not Checked"
                                    Status="draft"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- NIGHT PRICING -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Night Pricing" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>

                            <common:EmptyState x:Name="PricingEmptyState"/>

                            <ScrollViewer x:Name="PricingScrollViewer"
                                        Visibility="Collapsed">

                                <StackPanel x:Name="spNightCards"/>

                            </ScrollViewer>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PAYMENT -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Payment Information" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Payment Status" Style="{StaticResource CaptionStyle}"/>
                                <ComboBox x:Name="cbPaymentStatus" Style="{StaticResource ModernComboBoxStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="DepositPanel">
                                <TextBlock Text="Deposit (if any)" Style="{StaticResource CaptionStyle}"/>
                                <TextBox x:Name="txtDeposit" Style="{StaticResource SoftTextBoxStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SUMMARY -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="24" Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Booking Summary" Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,28,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Base Amount" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"  x:Name="txtBaseAmount" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Text="Discount" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDiscountAmount" Margin="0,12,0,0" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="2" Text="Cleaning Fee" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtCleaningFee" Margin="0,12,0,0" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="3" Text="Service Fee" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtServiceFee" Margin="0,12,0,0" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="4" Text="Tax" Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtTaxAmount" Margin="0,12,0,0" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,28"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Final Total" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtFinalAmount" 
                                       Grid.Column="1" 
                                       FontSize="36" 
                                       FontWeight="Bold" 
                                       Foreground="#D89C9D"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FOOTER -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Cancel" 
                            Grid.Column="1"
                            Width="140"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="btnCancel_Click"/>

                    <Button Content="Create Booking" 
                            Grid.Column="2"
                            Width="180"
                            Margin="16,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnCreateBooking_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
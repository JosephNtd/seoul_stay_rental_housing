<Window x:Class="GUI_WPF.Pages.Bookings.InvoiceGeneratedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Generated"
        Height="640"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- Spinning animation cho loading indicator -->
        <Storyboard x:Key="SpinAnimation"
                     RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0"
                             To="360"
                             Duration="0:0:1.2"/>
        </Storyboard>

    </Window.Resources>

    <Border CornerRadius="20"
            Background="White"
            BorderBrush="#F0DEDE"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    Background="#FAF7F2"
                    CornerRadius="20,20,0,0"
                    Padding="24,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Background="#E8F5E9"
                            CornerRadius="22">
                        <TextBlock Text="📄"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Invoice Generated"/>

                        <TextBlock x:Name="txtSubtitle"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Scan the QR code to proceed with payment."
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="✕"
                            FontSize="16"
                            Foreground="#6B5D5D"
                            Cursor="Hand"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="bd"
                                                Property="Background"
                                                Value="#FFF0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>

            </Border>

            <!-- ============================================ -->
            <!-- CONTENT                                      -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16,24,8">

                <StackPanel>

                    <!-- QR CODE PREVIEW -->
                    <Border Background="#FAF7F2"
                            CornerRadius="16"
                            Padding="20"
                            HorizontalAlignment="Center"
                            BorderBrush="#F0DEDE"
                            BorderThickness="1">

                        <StackPanel HorizontalAlignment="Center">

                            <Image x:Name="imgQrCode"
                                   Width="200"
                                   Height="200"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   RenderOptions.EdgeMode="Aliased"/>

                            <TextBlock Text="Scan to pay"
                                       FontSize="12"
                                       Foreground="#B9A9A9"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       FontFamily="Be Vietnam Pro"/>

                        </StackPanel>

                    </Border>

                    <!-- INVOICE INFO -->
                    <Border Margin="0,16,0,0"
                            Background="#FAF7F2"
                            CornerRadius="14"
                            Padding="16,14"
                            BorderBrush="#F0DEDE"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Invoice Details"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#3A3131"
                                       FontFamily="Be Vietnam Pro"/>

                            <!-- Invoice Code -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Invoice:"
                                           FontSize="12"
                                           Foreground="#8B7D7D"
                                           Width="80"
                                           FontFamily="Be Vietnam Pro"/>

                                <TextBlock x:Name="txtInvoiceCode"
                                           Grid.Column="1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#3A3131"
                                           FontFamily="Be Vietnam Pro"/>
                            </Grid>

                            <!-- Total Amount -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Amount:"
                                           FontSize="12"
                                           Foreground="#8B7D7D"
                                           Width="80"
                                           FontFamily="Be Vietnam Pro"/>

                                <TextBlock x:Name="txtTotalAmount"
                                           Grid.Column="1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#D89C9D"
                                           FontFamily="Be Vietnam Pro"/>
                            </Grid>

                            <!-- PDF Path -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PDF:"
                                           FontSize="12"
                                           Foreground="#8B7D7D"
                                           Width="80"
                                           FontFamily="Be Vietnam Pro"/>

                                <TextBlock x:Name="txtPdfPath"
                                           Grid.Column="1"
                                           FontSize="11"
                                           Foreground="#5B4E4E"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           FontFamily="Be Vietnam Pro"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- WAITING FOR PAYMENT INDICATOR -->
                    <Border x:Name="WaitingPanel"
                            Margin="0,16,0,0"
                            Background="#FFF8E1"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Spinner -->
                            <Canvas Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">

                                <Ellipse Width="22"
                                         Height="22"
                                         Stroke="#FFE0B2"
                                         StrokeThickness="2.5"
                                         Fill="Transparent"/>

                                <Path x:Name="SpinnerArc"
                                      Data="M 11,0.5 A 10.5,10.5 0 0 1 21.5,11"
                                      Stroke="#F57C00"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      RenderTransformOrigin="0.5,0.5">

                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerTransform"
                                                         Angle="0"/>
                                    </Path.RenderTransform>

                                </Path>

                            </Canvas>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Waiting for payment..."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           FontFamily="Be Vietnam Pro"/>

                                <TextBlock Text="Payment status will update automatically when the guest completes payment via QR code."
                                           FontSize="11"
                                           Foreground="#F57C00"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"
                                           FontFamily="Be Vietnam Pro"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- PAYMENT COMPLETED INDICATOR (hidden by default) -->
                    <Border x:Name="CompletedPanel"
                            Visibility="Collapsed"
                            Margin="0,16,0,0"
                            Background="#E8F5E9"
                            BorderBrush="#A5D6A7"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="22"
                                    Height="22"
                                    Background="#4CAF50"
                                    CornerRadius="11"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✓"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Payment received! Booking has been confirmed."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#2E7D32"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontFamily="Be Vietnam Pro"/>

                        </Grid>

                    </Border>

                    <!-- CANCELLED INDICATOR (hidden by default) -->
                    <Border x:Name="CancelledPanel"
                            Visibility="Collapsed"
                            Margin="0,16,0,0"
                            Background="#FDECEC"
                            BorderBrush="#F8CACA"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="22"
                                    Height="22"
                                    Background="#D32F2F"
                                    CornerRadius="11"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✕"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Payment was cancelled by the guest."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#D32F2F"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontFamily="Be Vietnam Pro"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="2"
                    Background="#FAF7F2"
                    CornerRadius="0,0,20,20"
                    Padding="24,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButtonStyle}"
                            Content="Close"
                            Width="120"
                            Click="btnClose_Click"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Open PDF"
                            Width="140"
                            Click="btnOpenPdf_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

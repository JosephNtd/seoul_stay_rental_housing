<Window x:Class="GUI_WPF.Pages.Catalog.CouponEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Coupon"
        Height="700"
        Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="20"
            Background="White"
            BorderBrush="#F0DEDE"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    Background="#FAF7F2"
                    CornerRadius="20,20,0,0"
                    Padding="24,20">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Background="#FFF0F0"
                            CornerRadius="22">
                        <TextBlock Text="🎟️"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="txtTitle"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="New Coupon"/>

                        <TextBlock x:Name="txtSubtitle"
                                   Style="{StaticResource CaptionStyle}"
                                   Text="Create a discount coupon for guest bookings."
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="✕"
                            FontSize="16"
                            Foreground="#6B5D5D"
                            Cursor="Hand"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="bd"
                                                Property="Background"
                                                Value="#FFF0F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>

            </Border>

            <!-- ============================================ -->
            <!-- FORM                                         -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20,24,8">

                <StackPanel>

                    <!-- COUPON CODE -->
                    <TextBlock Style="{StaticResource LabelStyle}"
                               Text="Coupon Code *"/>

                    <TextBox x:Name="txtCode"
                             Style="{StaticResource SoftTextBoxStyle}"
                             Margin="0,6,0,0"
                             MaxLength="50"/>

                    <!-- DISCOUNT % + MAX -->
                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Discount Percent (%) *"/>

                            <TextBox x:Name="txtDiscountPercent"
                                     Style="{StaticResource SoftTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Maximum Discount (₫) *"/>

                            <TextBox x:Name="txtMaxDiscount"
                                     Style="{StaticResource SoftTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>

                        </StackPanel>

                    </Grid>

                    <!-- DATES -->
                    <Grid Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Start Date *"/>

                            <DatePicker x:Name="dpStart"
                                        Style="{StaticResource SoftDatePickerStyle}"
                                        Margin="0,6,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Style="{StaticResource LabelStyle}"
                                       Text="Expiration Date"/>

                            <DatePicker x:Name="dpExpiration"
                                        Style="{StaticResource SoftDatePickerStyle}"
                                        Margin="0,6,0,0"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Leave Expiration empty for no end date."
                               Margin="0,6,0,0"/>

                    <!-- MAX USAGE COUNT -->
                    <StackPanel Margin="0,16,0,0">

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Maximum Usage Count"/>

                        <TextBox x:Name="txtMaxUsage"
                                 Style="{StaticResource SoftTextBoxStyle}"
                                 Margin="0,6,0,0"
                                 PreviewTextInput="IntegerOnly_PreviewTextInput"/>

                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Leave empty for unlimited uses."
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                    <!-- ACTIVE -->
                    <Border Margin="0,18,0,0"
                            Background="#FAF7F2"
                            CornerRadius="14"
                            Padding="16,12"
                            BorderBrush="#F0DEDE"
                            BorderThickness="1.5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Coupon is active"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#3A3131"/>
                                <TextBlock Text="Inactive coupons cannot be applied during booking."
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="chkActive"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="True"/>

                        </Grid>

                    </Border>

                    <!-- USAGE INFO (EDIT MODE ONLY) -->
                    <Border x:Name="UsageInfoPanel"
                            Visibility="Collapsed"
                            Margin="0,14,0,0"
                            Background="#EEF4FF"
                            BorderBrush="#D7E5FF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12">

                        <StackPanel>

                            <TextBlock Text="Usage Information"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#4F7BDB"/>

                            <TextBlock x:Name="txtUsageInfo"
                                       FontSize="13"
                                       Foreground="#3A3131"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="2"
                    Background="#FAF7F2"
                    CornerRadius="0,0,20,20"
                    Padding="24,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButtonStyle}"
                            Content="Cancel"
                            Width="120"
                            Click="btnCancel_Click"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Save"
                            Width="140"
                            Click="btnSave_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

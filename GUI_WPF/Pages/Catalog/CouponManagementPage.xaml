<UserControl x:Class="GUI_WPF.Pages.Catalog.CouponManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:GUI_WPF.UserControls.Common"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stats -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- HEADER                                       -->
        <!-- ============================================ -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Coupon Management"/>

                <TextBlock Style="{StaticResource BodyTextStyle}"
                           Text="Create and manage discount coupons used in bookings."
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="+ New Coupon"
                    Width="170"
                    VerticalAlignment="Center"
                    Click="btnNew_Click"/>

        </Grid>

        <!-- ============================================ -->
        <!-- STATS                                        -->
        <!-- ============================================ -->
        <Grid Grid.Row="1"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL -->
            <Border Grid.Column="0"
                    Style="{StaticResource GlassCardStyle}">

                <StackPanel>

                    <Border Width="44"
                            Height="44"
                            Background="#FFF0F0"
                            CornerRadius="22"
                            HorizontalAlignment="Left">
                        <TextBlock Text="🎟️"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Total Coupons"
                               Margin="0,16,0,0"/>

                    <TextBlock x:Name="txtTotalCount"
                               Style="{StaticResource StatNumberStyle}"
                               Text="0"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <!-- ACTIVE -->
            <Border Grid.Column="1"
                    Style="{StaticResource GlassCardStyle}">

                <StackPanel>

                    <Border Width="44"
                            Height="44"
                            Background="#EAF8F0"
                            CornerRadius="22"
                            HorizontalAlignment="Left">
                        <TextBlock Text="✓"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2E7D5A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Active"
                               Margin="0,16,0,0"/>

                    <TextBlock x:Name="txtActiveCount"
                               Style="{StaticResource StatNumberStyle}"
                               Text="0"
                               Foreground="#2E7D5A"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <!-- EXPIRED -->
            <Border Grid.Column="2"
                    Style="{StaticResource GlassCardStyle}">

                <StackPanel>

                    <Border Width="44"
                            Height="44"
                            Background="#FDECEC"
                            CornerRadius="22"
                            HorizontalAlignment="Left">
                        <TextBlock Text="⏰"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Expired"
                               Margin="0,16,0,0"/>

                    <TextBlock x:Name="txtExpiredCount"
                               Style="{StaticResource StatNumberStyle}"
                               Text="0"
                               Foreground="#D32F2F"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

            <!-- USED UP -->
            <Border Grid.Column="3"
                    Style="{StaticResource GlassCardStyle}">

                <StackPanel>

                    <Border Width="44"
                            Height="44"
                            Background="#FFF8E8"
                            CornerRadius="22"
                            HorizontalAlignment="Left">
                        <TextBlock Text="🚫"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Used Up / Inactive"
                               Margin="0,16,0,0"/>

                    <TextBlock x:Name="txtInactiveCount"
                               Style="{StaticResource StatNumberStyle}"
                               Text="0"
                               Foreground="#B98500"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ============================================ -->
        <!-- TOOLBAR                                      -->
        <!-- ============================================ -->
        <Grid Grid.Row="2"
              Margin="8,12,8,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <uc:SearchBox x:Name="sb"
                          Placeholder="Search by coupon code..."
                          TextChanged="sb_TextChanged"/>

            <ComboBox x:Name="cbStatusFilter"
                      Grid.Column="2"
                      Style="{StaticResource ModernComboBoxStyle}"
                      SelectionChanged="cbStatusFilter_SelectionChanged">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

        </Grid>

        <!-- ============================================ -->
        <!-- DATAGRID                                     -->
        <!-- ============================================ -->
        <Border Grid.Row="3"
                Style="{StaticResource SectionCardStyle}"
                Margin="8,0,8,8"
                Padding="0">

            <Grid>

                <DataGrid x:Name="dgCoupons"
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource SoftColumnHeaderStyle}"
                          CellStyle="{StaticResource SoftCellStyle}"
                          RowStyle="{StaticResource SoftRowStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          MouseDoubleClick="dgCoupons_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Code"
                                            Binding="{Binding CouponCode}"
                                            Width="*"
                                            MinWidth="140"/>

                        <DataGridTextColumn Header="Discount"
                                            Binding="{Binding DiscountPercentDisplay}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Max Discount"
                                            Binding="{Binding MaxDiscountDisplay}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Start"
                                            Binding="{Binding StartedDateDisplay}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Expiration"
                                            Binding="{Binding ExpirationDisplay}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Usage"
                                            Binding="{Binding UsageDisplay}"
                                            Width="100"/>

                        <DataGridTemplateColumn Header="Status"
                                                Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <uc:StatusChip Text="{Binding StatusText}"
                                                   Status="{Binding StatusText}"
                                                   VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header=""
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">

                                        <Button Width="36"
                                                Height="36"
                                                Margin="0,0,6,0"
                                                Background="#EEF4FF"
                                                Foreground="#4F7BDB"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Content="✏"
                                                FontSize="14"
                                                ToolTip="Edit"
                                                Click="btnEdit_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="36"
                                                Height="36"
                                                Background="#FDECEC"
                                                Foreground="#D32F2F"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Content="🗑"
                                                FontSize="14"
                                                ToolTip="Delete"
                                                Click="btnDelete_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- EMPTY STATE -->
                <uc:EmptyState x:Name="EmptyState"
                               Visibility="Collapsed"
                               Icon="🎟️"
                               Title="No Coupons Yet"
                               Description="Create your first discount coupon to offer to guests during booking."
                               ButtonText="Create First Coupon"
                               ActionClicked="EmptyState_ActionClicked"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>

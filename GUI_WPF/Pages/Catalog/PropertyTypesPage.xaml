 <Page x:Class="GUI_WPF.Pages.Catalog.PropertyTypesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:common="clr-namespace:GUI_WPF.UserControls.Common"
      xmlns:cards="clr-namespace:GUI_WPF.UserControls.Cards"
      xmlns:drawers="clr-namespace:GUI_WPF.UserControls.Drawers"
      mc:Ignorable="d"
      Background="#FFF8F4">

    <Grid Margin="26">

        
        <!-- ROOT -->
        

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <!-- HEADER -->
        

        <Grid Margin="0,0,0,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <StackPanel>

                <TextBlock Text="Property Types"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#3A3131"/>

                <TextBlock Text="Manage visual accommodation categories for guests and listings"
                           Margin="0,8,0,0"
                           FontSize="14"
                           Foreground="#8B7D7D"/>

            </StackPanel>

            <!-- ACTIONS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="btnCreateType"
                        Content="+ New Property Type"
                        Width="190"
                        Height="50"
                        Margin="0,0,14,0"
                        Click="btnCreateType_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <Button x:Name="btnPreviewGuest"
                        Content="Preview Guest View"
                        Width="170"
                        Height="50"
                        Click="btnPreviewGuest_Click"
                        Style="{StaticResource OutlineButtonStyle}"/>

            </StackPanel>

        </Grid>

        
        <!-- FILTER -->
        

        <Border Grid.Row="1"
                Style="{StaticResource GlassCardStyle}"
                Padding="18"
                Margin="0,0,0,24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH -->
                <common:SearchBox x:Name="txtSearch"
                                  Placeholder="Search property type..."
                                  TextChanged="txtSearch_TextChanged"/>

                <!-- SORT -->
                <ComboBox x:Name="cboSort"
                          Grid.Column="1"
                          Margin="18,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="cboSort_SelectionChanged"
                          Style="{StaticResource ModernComboBoxStyle}">

                    <ComboBoxItem Content="Most Listings"/>
                    <ComboBoxItem Content="A-Z"/>
                    <ComboBoxItem Content="Newest"/>

                </ComboBox>

                <!-- VIEW -->
                <ComboBox x:Name="cboViewMode"
                          Grid.Column="2"
                          Margin="18,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="cboViewMode_SelectionChanged"
                          Style="{StaticResource ModernComboBoxStyle}">

                    <ComboBoxItem Content="Grid View"/>
                    <ComboBoxItem Content="Compact View"/>

                </ComboBox>

            </Grid>

        </Border>

        
        <!-- MAIN -->
        

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <!-- CONTENT -->
                <ColumnDefinition Width="*"/>

                <!-- DRAWER -->
                <ColumnDefinition Width="420"/>

            </Grid.ColumnDefinitions>

            
            <!-- LEFT -->
            

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Margin="0,0,22,0">

                <WrapPanel x:Name="wpPropertyTypes"
                           ItemWidth="320"/>

            </ScrollViewer>

            
            <!-- RIGHT -->
            

            <drawers:PropertyTypeDrawer
                x:Name="drawerInspector"
                Grid.Column="1"/>

        </Grid>

    </Grid>

</Page>

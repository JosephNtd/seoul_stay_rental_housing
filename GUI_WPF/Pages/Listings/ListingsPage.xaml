<Page x:Class="GUI_WPF.Pages.Listings.ListingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:cards="clr-namespace:GUI_WPF.UserControls.Cards"
      xmlns:drawers="clr-namespace:GUI_WPF.UserControls.Drawers"
      mc:Ignorable="d"
      Background="#F7F4F2">

    <Grid>

        <!-- MAIN -->
        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HERO -->


            <Border Background="White"
                    CornerRadius="28"
                    Padding="28,16">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="26"
                                      ShadowDepth="0"
                                      Color="#D8C5BC"
                                      Opacity="0.15"/>

                </Border.Effect>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TITLE + SUBTITLE -->

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Listings Management"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2F2622"/>

                        <TextBlock Margin="0,5,0,0"
                                   Text="Manage properties, availability, pricing and stay experience."
                                   FontSize="13"
                                   Foreground="#8C7F79"/>

                    </StackPanel>

                    <!-- STATS -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">

                        <Border Background="#EEF8F1"
                                CornerRadius="16"
                                Padding="16,10"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Active"
                                           FontSize="11"
                                           Foreground="#5B6D61"/>

                                <TextBlock x:Name="txtActiveListings"
                                           Margin="0,4,0,0"
                                           Text="18"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1E7A45"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#FFF4EC"
                                CornerRadius="16"
                                Padding="16,10"
                                Margin="0,0,10,0">

                            <StackPanel>

                                <TextBlock Text="Draft"
                                           FontSize="11"
                                           Foreground="#7A6456"/>

                                <TextBlock x:Name="txtDraftListings"
                                           Margin="0,4,0,0"
                                           Text="4"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#D97706"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#F3F0FF"
                                CornerRadius="16"
                                Padding="16,10">

                            <StackPanel>

                                <TextBlock Text="Total"
                                           FontSize="11"
                                           Foreground="#665D8A"/>

                                <TextBlock x:Name="txtTotalListings"
                                           Margin="0,4,0,0"
                                           Text="22"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#5B4CC4"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- BUTTONS -->

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="btnRefresh"
                                Style="{StaticResource SuccessButtonStyle}"
                                Width="110"
                                Height="46"
                                Margin="0,0,12,0"
                                Content="Refresh"
                                Cursor="Hand"
                                Background="#F3ECE8"
                                BorderThickness="0"
                                Click="btnRefresh_Click"/>

                        <Button x:Name="btnAddListing"
                                Style="{StaticResource OutlineButtonStyle}"
                                Width="160"
                                Height="46"
                                Content="+ Add Listing"
                                Click="btnAddListing_Click">

                            

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- FILTER BAR -->


            <Border Grid.Row="1"
                    Margin="0,26,0,0"
                    Background="White"
                    CornerRadius="28"
                    Padding="24">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH -->

                    <Border Background="#F8F4F1"
                            CornerRadius="18"
                            Height="52"
                            Padding="18,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔎"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtSearch"
                                     Grid.Column="1"
                                     Margin="12,0,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="txtSearch_TextChanged"/>
                        </Grid>

                    </Border>

                    <!-- TYPE -->

                    <ComboBox x:Name="cbTypeFilter"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Grid.Column="1"
                              Margin="18,0,0,0"
                              Height="52"
                              FontSize="14"
                              SelectionChanged="cbTypeFilter_SelectionChanged"/>

                    <!-- STATUS -->

                    <ComboBox x:Name="cbStatusFilter"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Grid.Column="2"
                              Margin="18,0,0,0"
                              Height="52"
                              FontSize="14"
                              SelectionChanged="cbStatusFilter_SelectionChanged"/>

                    <!-- SORT -->

                    <ComboBox x:Name="cbSort"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Grid.Column="3"
                              Margin="18,0,0,0"
                              Height="52"
                              FontSize="14"
                              SelectionChanged="cbSort_SelectionChanged"/>

                </Grid>

            </Border>


            <!-- LISTINGS -->


            <ScrollViewer Grid.Row="2"
                          Margin="0,26,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,4,8,8">

                <WrapPanel x:Name="wpListings"
                           Orientation="Horizontal"/>

            </ScrollViewer>

        </Grid>


        <!-- OVERLAY -->


        <Grid x:Name="OverlayPanel"
              Background="#66000000"
              Visibility="Collapsed">

            <drawers:ListingEditorDrawer x:Name="listingEditorDrawer"
                                         HorizontalAlignment="Right"
                                         Visibility="Collapsed"/>

        </Grid>

    </Grid>

</Page>
<Page x:Class="GUI_WPF.Pages.Reports.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F8F6F4">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="24">

                <!-- TITLE -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Reports Dashboard"
               Style="{StaticResource PageTitleStyle}"/>

                    <Button Grid.Column="1"
                            Content="Refresh"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="btnRefresh_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Grid.Column="2"
            Content="Export PDF"
            Width="140"
            Height="40"
            Click="btnExportPdf_Click"
            Style="{StaticResource PrimaryButtonStyle}"/>

                </Grid>

                <!-- KPI CARDS -->

                <UniformGrid Columns="4"
             Margin="0,0,0,20">

                    <!-- Revenue -->

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Total Revenue"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtTotalRevenue"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#2AA876"/>

                        </StackPanel>

                    </Border>

                    <!-- Bookings -->

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Total Bookings"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtTotalBookings"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#3A86E9"/>

                        </StackPanel>

                    </Border>

                    <!-- Occupancy -->

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Occupancy Rate"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtOccupancy"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#F4A261"/>

                        </StackPanel>

                    </Border>

                    <!-- Avg Booking -->

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Average Booking"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtAverageBooking"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#6C63FF"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>
                <UniformGrid Columns="4"
             Margin="0,0,0,20">

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Today's Revenue"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtTodayRevenue"
                       FontSize="24"
                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Monthly Revenue"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtMonthlyRevenue"
                       FontSize="24"
                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Active Stays"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtActiveStays"
                       FontSize="24"
                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}"
            Margin="6">

                        <StackPanel Margin="18">

                            <TextBlock Text="Returning Guests"
                       Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock x:Name="txtReturningGuests"
                       FontSize="24"
                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

                <!-- REVENUE TREND -->

                <Border Style="{StaticResource SectionCardStyle}"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Revenue Trend"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgRevenueTrend"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Height="320">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Month"
                                    Binding="{Binding Label}"/>

                                <DataGridTextColumn
                                    Header="Revenue"
                                    Binding="{Binding Revenue,StringFormat=N0}"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

                <!-- STATUS + AREA -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- STATUS -->

                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Booking Status"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="dgBookingStatus"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      Height="250">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Status"
                                        Binding="{Binding Status}"/>

                                    <DataGridTextColumn
                                        Header="Count"
                                        Binding="{Binding Count}"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                    <!-- AREA -->

                    <Border Grid.Column="2"
                            Style="{StaticResource SectionCardStyle}"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Revenue By Area"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <DataGrid x:Name="dgAreaRevenue"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      Height="250">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Area"
                                        Binding="{Binding AreaName}"/>

                                    <DataGridTextColumn
                                        Header="Revenue"
                                        Binding="{Binding Revenue,StringFormat=N0}"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- TOP LISTINGS -->

                <Border Style="{StaticResource SectionCardStyle}"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Top Listings"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgTopListings"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  Height="320">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Listing"
                                    Binding="{Binding Title}"
                                    Width="*"/>

                                <DataGridTextColumn
                                    Header="Revenue"
                                    Binding="{Binding Revenue,StringFormat=N0}"
                                    Width="150"/>

                                <DataGridTextColumn
                                    Header="Bookings"
                                    Binding="{Binding BookingCount}"
                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>
<Page x:Class="GUI_WPF.Pages.Users.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:cards="clr-namespace:GUI_WPF.UserControls.Cards"
      xmlns:panels="clr-namespace:GUI_WPF.UserControls.Panels"
      xmlns:timeline="clr-namespace:GUI_WPF.UserControls.Timeline"
      xmlns:local="clr-namespace:GUI_WPF.Pages.Users"
      xmlns:drawers="clr-namespace:GUI_WPF.UserControls.Drawers"
      mc:Ignorable="d"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      Background="#FFF8F4">


    <!-- ROOT -->


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Background="#AAFFFFFF"
                Padding="28"
                Margin="24,24,24,0"
                CornerRadius="34">

            <Border.Effect>

                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.05"/>

            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel>

                    <TextBlock Text="Users Workspace"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#3A3131"/>

                    <TextBlock Text="Manage guests, hosts, trust, bookings and financial activity"
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#9B8C8C"/>

                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- SEARCH -->
                    <Border Background="#FFF8F4"
                            CornerRadius="20"
                            Padding="16,10"
                            Margin="0,0,14,0">

                        <DockPanel Width="260">

                            <TextBlock Text="🔍"
                                       FontSize="14"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtSearch"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="#3A3131"
                                     VerticalContentAlignment="Center"
                                     TextChanged="txtSearch_TextChanged"/>

                        </DockPanel>

                    </Border>

                    <!-- ROLE FILTER -->
                    <ComboBox x:Name="cbRoleFilter"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="150"
                              Height="46"
                              Margin="0,0,14,0"
                              SelectionChanged="cbRoleFilter_SelectionChanged">

                        <ComboBoxItem Content="All Roles"/>
                        <ComboBoxItem Content="Guests"/>
                        <ComboBoxItem Content="Hosts"/>
                        <ComboBoxItem Content="Admins"/>

                    </ComboBox>

                    <!-- STATUS FILTER -->
                    <ComboBox x:Name="cbStatusFilter"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Width="150"
                              Height="46"
                              Margin="0,0,14,0"
                              SelectionChanged="cbStatusFilter_SelectionChanged">

                        <ComboBoxItem Content="All Status"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Locked"/>

                    </ComboBox>

                    <!-- ADD USER -->
                    <Button x:Name="btnAddUser"
                            Content="+ Add User"
                            Width="150"
                            Height="48"
                            Click="btnAddUser_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CONTENT -->

        <Grid Grid.Row="1"
              Margin="24">

            <Grid.ColumnDefinitions>

                <!-- DIRECTORY -->
                <ColumnDefinition Width="360"/>

                <!-- MAIN -->
                <ColumnDefinition Width="*"/>

                <!-- INSIGHTS -->
                <ColumnDefinition Width="390"/>

            </Grid.ColumnDefinitions>


            <!-- LEFT : USER DIRECTORY -->


            <Border Background="#AAFFFFFF"
                    CornerRadius="34"
                    Padding="14
"
                    Margin="0,0,10,0">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.05"/>

                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Directory"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#3A3131"/>

                            <TextBlock x:Name="txtDirectoryCount"
                                       Text="128 users"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="#9B8C8C"/>

                        </StackPanel>

                        <!-- REFRESH -->
                        <Button x:Name="btnRefreshUsers"
                                Grid.Column="1"
                                Content="↻"
                                Width="46"
                                Height="46"
                                Click="btnRefreshUsers_Click"
                                Style="{StaticResource OutlineButtonStyle}"/>

                    </Grid>

                    <!-- USERS -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,0"
                                  VerticalScrollBarVisibility="Hidden">

                        <StackPanel x:Name="spUsers">

                            <!-- USER CARD SAMPLE -->
                            <!-- dynamic load -->


                            <cards:UserDirectoryCard/>


                        </StackPanel>

                    </ScrollViewer>

                    <!-- PAGINATION -->
                    <Grid Grid.Row="2"
                          Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- PREV -->
                        <Button x:Name="btnPrevPage"
                                Content="← Previous"
                                Width="120"
                                Height="42"
                                Click="btnPrevPage_Click"
                                Style="{StaticResource OutlineButtonStyle}"/>

                        <!-- PAGE -->
                        <TextBlock x:Name="txtPagination"
                                   Grid.Column="1"
                                   Text="Page 1 / 12"
                                   FontSize="13"
                                   Foreground="#8B7D7D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- NEXT -->
                        <Button x:Name="btnNextPage"
                                Grid.Column="2"
                                Content="Next →"
                                Width="120"
                                Height="42"
                                Click="btnNextPage_Click"
                                Style="{StaticResource OutlineButtonStyle}"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- CENTER : WORKSPACE -->


            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">

                <StackPanel>


                    <!-- HERO -->


                    <panels:UserHeroProfile x:Name="heroProfile"
                                            Margin="0,0,0,24"/>


                    <!-- STATS -->


                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="spStatCards"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,24">

                            <!-- dynamic -->

                        </StackPanel>

                    </ScrollViewer>


                    <!-- BOOKINGS -->


                    <Border Background="#AAFFFFFF"
                            CornerRadius="34"
                            Padding="28"
                            Margin="0,0,0,24">

                        <Border.Effect>

                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.05"/>

                        </Border.Effect>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Bookings"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#3A3131"/>

                                    <TextBlock Text="Reservations &amp; stay activity"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="#9B8C8C"/>

                                </StackPanel>

                                <!-- FILTER -->
                                <ComboBox x:Name="cbBookingFilter"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          Grid.Column="1"
                                          Width="180"
                                          Height="46"
                                          SelectionChanged="cbBookingFilter_SelectionChanged">

                                    <ComboBoxItem Content="All Bookings"/>
                                    <ComboBoxItem Content="Upcoming"/>
                                    <ComboBoxItem Content="Completed"/>
                                    <ComboBoxItem Content="Cancelled"/>

                                </ComboBox>

                            </Grid>

                            <!-- CONTENT -->
                            <StackPanel x:Name="spBookings"
                                        Grid.Row="1"
                                        Margin="0,28,0,0">

                                <!-- dynamic -->

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- TRANSACTIONS -->


                    <Border Background="#AAFFFFFF"
                            CornerRadius="34"
                            Padding="28"
                            Margin="0,0,0,24">

                        <Border.Effect>

                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.05"/>

                        </Border.Effect>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Transactions"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#3A3131"/>

                                    <TextBlock Text="Payments, refunds &amp; payouts"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="#9B8C8C"/>

                                </StackPanel>

                                <!-- ACTION -->
                                <Button x:Name="btnExportTransactions"
                                        Grid.Column="1"
                                        Content="Export"
                                        Width="120"
                                        Height="46"
                                        
                                        Style="{StaticResource OutlineButtonStyle}"/>

                            </Grid>

                            <!-- TIMELINE -->
                            <StackPanel x:Name="spTransactions"
                                        Grid.Row="1"
                                        Margin="0,28,0,0">

                                <!-- dynamic -->

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- BANK ACCOUNTS -->


                    <Border Background="#AAFFFFFF"
                            CornerRadius="34"
                            Padding="28"
                            Margin="0,0,0,40">

                        <Border.Effect>

                            <DropShadowEffect BlurRadius="24"
                                              ShadowDepth="0"
                                              Opacity="0.05"/>

                        </Border.Effect>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Bank Accounts"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#3A3131"/>

                                    <TextBlock Text="Payout destinations &amp; verification"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="#9B8C8C"/>

                                </StackPanel>

                                <!-- ADD -->
                                <Button x:Name="btnAddBank"
                                        Grid.Column="1"
                                        Content="+ Add Bank"
                                        Width="150"
                                        Height="46"
                                        Click="btnAddBank_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                            </Grid>

                            <!-- CONTENT -->
                            <WrapPanel x:Name="wpBankAccounts"
                                       Grid.Row="1"
                                       Margin="0,28,0,0">

                                <!-- dynamic -->

                            </WrapPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- RIGHT : INSIGHTS -->


            <ScrollViewer Grid.Column="2"
              Margin="24,0,0,0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- INSIGHTS -->
                    <panels:UserInsightsPanel x:Name="insightsPanel"/>

                    <!-- QUICK ACTIONS -->
                    <Border Background="#AAFFFFFF"
                CornerRadius="34"
                Padding="24"
                Margin="0,24,0,0">

                        <Border.Effect>

                            <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.05"/>

                        </Border.Effect>

                        <StackPanel>

                            <TextBlock Text="Quick Actions"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#3A3131"/>

                            <Button x:Name="btnEditUser"
                        Content="Edit User"
                        Margin="0,24,0,0"
                        Height="52"
                        Click="btnEditUser_Click"
                        Style="{StaticResource OutlineButtonStyle}"/>

                            <Button x:Name="btnResetPassword"
                        Content="Reset Password"
                        Margin="0,14,0,0"
                        Height="52"
                        Click="btnResetPassword_Click"
                        Style="{StaticResource OutlineButtonStyle}"/>

                            <Button x:Name="btnLockUser"
                        Content="Lock User"
                        Margin="0,14,0,0"
                        Height="52"
                        Click="btnLockUser_Click"
                        Style="{StaticResource DangerButtonStyle}"/>

                            <Button x:Name="btnDeleteUser"
                        Content="Delete User"
                        Margin="0,14,0,0"
                        Height="52"
                        Click="btnDeleteUser_Click"
                        Style="{StaticResource DangerButtonStyle}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>
        </Grid>
        <Grid x:Name="OverlayLayer"
              Grid.RowSpan="2"
              Background="#66000000"
              Visibility="Collapsed"
              Panel.ZIndex="999">

            <!-- USER EDITOR -->
            <drawers:UserEditorDrawer x:Name="userEditorDrawer"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"/>

            <!-- BANK EDITOR -->
            <drawers:BankEditorDrawer x:Name="bankEditorDrawer"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"/>

        </Grid>
    </Grid>

</Page>
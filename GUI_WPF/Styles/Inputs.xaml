<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TEXTBOX -->
    <Style x:Key="SoftTextBoxStyle"
       TargetType="TextBox">
        
        <Setter Property="VerticalContentAlignment"
        Value="Center"/>

        <Setter Property="Padding"
        Value="12,0"/>
        <Setter Property="Height"
            Value="46"/>

        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="Foreground"
            Value="#3A3131"/>


        <Setter Property="Background"
            Value="#FAF7F2"/>

        <Setter Property="BorderBrush"
            Value="#F0DEDE"/>

        <Setter Property="BorderThickness"
            Value="1.5"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="TextBox">

                    <Border x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="4,0"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- FOCUS -->
                        <Trigger Property="IsKeyboardFocused"
                             Value="True">

                            <Setter TargetName="bd"
                                Property="BorderBrush"
                                Value="#D89C9D"/>

                            <Setter TargetName="bd"
                                Property="Background"
                                Value="#FFFFFF"/>

                        </Trigger>

                        <!-- DISABLED -->
                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter Property="Opacity"
                                Value="0.5"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- PASSWORD -->
    <Style x:Key="SoftPasswordBoxStyle"
       TargetType="PasswordBox">
        <Setter Property="VerticalContentAlignment"
        Value="Center"/>

        <Setter Property="Padding"
        Value="12,0"/>
        <Setter Property="Height"
    Value="46"/>

        <Setter Property="FontSize"
    Value="14"/>

        <Setter Property="Foreground"
    Value="#3A3131"/>

        <Setter Property="Background"
    Value="#FAF7F2"/>

        <Setter Property="BorderBrush"
    Value="#F0DEDE"/>

        <Setter Property="BorderThickness"
    Value="1.5"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="PasswordBox">

                    <Border x:Name="bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="16">

                        <ScrollViewer x:Name="PART_ContentHost"
                          Margin="4,0"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- FOCUS -->
                        <Trigger Property="IsKeyboardFocused"
                     Value="True">

                            <Setter TargetName="bd"
                        Property="BorderBrush"
                        Value="#D89C9D"/>

                            <Setter TargetName="bd"
                        Property="Background"
                        Value="#FFFFFF"/>

                        </Trigger>

                        <!-- DISABLED -->
                        <Trigger Property="IsEnabled"
                     Value="False">

                            <Setter Property="Opacity"
                        Value="0.5"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>
    </Style>

    <!-- COMBOBOX -->
    <Style x:Key="SoftComboBoxStyle"
       TargetType="ComboBox">

        <Setter Property="Height"
            Value="46"/>

        <Setter Property="Background"
            Value="#FAF7F2"/>

        <Setter Property="BorderBrush"
            Value="#F0DEDE"/>

        <Setter Property="BorderThickness"
            Value="1.5"/>

        <Setter Property="Padding"
            Value="14,0"/>

        <Setter Property="FontSize"
            Value="14"/>

    </Style>

    <!-- DATEPICKER -->
    <Style x:Key="SoftDatePickerStyle"
       TargetType="DatePicker">

        <Setter Property="Height"
            Value="46"/>

        <Setter Property="Background"
            Value="#FAF7F2"/>

        <Setter Property="BorderBrush"
            Value="#F0DEDE"/>

        <Setter Property="BorderThickness"
            Value="1.5"/>

    </Style>

    <!-- SEARCH BOX -->
    <Style x:Key="SearchTextBoxStyle"
   TargetType="TextBox"
   BasedOn="{StaticResource SoftTextBoxStyle}">

        <Setter Property="Height"
        Value="42"/>

        <Setter Property="Background"
        Value="#FFFFFF"/>

    </Style>
    
    <!-- TEXTAREA -->
    <Style x:Key="SoftTextAreaStyle"
       TargetType="TextBox">

        <Setter Property="AcceptsReturn"
            Value="True"/>

        <Setter Property="TextWrapping"
            Value="Wrap"/>

        <Setter Property="VerticalScrollBarVisibility"
            Value="Auto"/>

        <Setter Property="MinHeight"
            Value="120"/>

        <Setter Property="Padding"
            Value="18"/>

    </Style>

    <!-- VALIDATION -->
    <Style x:Key="ValidationTextStyle"
       TargetType="TextBlock">

        <Setter Property="Foreground"
            Value="#D32F2F"/>

        <Setter Property="FontSize"
            Value="12"/>

        <Setter Property="Margin"
            Value="4,6,0,0"/>

    </Style>

</ResourceDictionary>
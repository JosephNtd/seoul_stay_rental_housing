<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DISPLAY TITLE -->
    <Style x:Key="DisplayTitleStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Plus Jakarta Sans"/>

        <Setter Property="FontSize"
            Value="40"/>

        <Setter Property="FontWeight"
            Value="Bold"/>

        <Setter Property="Foreground"
            Value="#3A3131"/>

        <Setter Property="TextOptions.TextFormattingMode"
            Value="Ideal"/>

    </Style>

    <!-- PAGE TITLE -->
    <Style x:Key="PageTitleStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Plus Jakarta Sans"/>

        <Setter Property="FontSize"
            Value="28"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Foreground"
            Value="#3A3131"/>

    </Style>

    <!-- SECTION TITLE -->
    <Style x:Key="SectionTitleStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Plus Jakarta Sans"/>

        <Setter Property="FontSize"
            Value="20"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Foreground"
            Value="#3A3131"/>

    </Style>
    
    <Style x:Key="CardTitleStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="Foreground"
            Value="#8B7D7D"/>

        <Setter Property="FontWeight"
            Value="Medium"/>

    </Style>

    <!-- BODY -->
    <Style x:Key="BodyTextStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="Foreground"
            Value="#5B4E4E"/>

        <Setter Property="TextWrapping"
            Value="Wrap"/>

    </Style>

    <!-- LABEL -->
    <Style x:Key="LabelStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="13"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Foreground"
            Value="#5B4E4E"/>

    </Style>

    <!-- CAPTION -->
    <Style x:Key="CaptionStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="12"/>

        <Setter Property="Foreground"
            Value="#B9A9A9"/>

    </Style>

    <!-- STAT -->
    <Style x:Key="StatNumberStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Plus Jakarta Sans"/>

        <Setter Property="FontSize"
            Value="34"/>

        <Setter Property="FontWeight"
            Value="Bold"/>

        <Setter Property="Foreground"
            Value="#3A3131"/>

    </Style>

    <Style x:Key="SidebarTextStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <Setter Property="Foreground"
            Value="#6B5D5D"/>

    </Style>

    <Style x:Key="ChipTextStyle"
       TargetType="TextBlock">

        <Setter Property="FontFamily"
            Value="Be Vietnam Pro"/>

        <Setter Property="FontSize"
            Value="12"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

    </Style>

</ResourceDictionary>
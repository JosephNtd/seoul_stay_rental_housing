<UserControl x:Class="GUI_WPF.UserControls.Cards.AmenityChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="221"
             Height="92"   
             Margin="0,0,20,20">

    <Border x:Name="RootBorder"
            Background="#FFF8F4"
            BorderBrush="#E8D8D2"
            BorderThickness="1.4"
            CornerRadius="22"
            Padding="14,12"
            Cursor="Hand"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="0"
                              Color="#D8C2BA"
                              Opacity="0.12"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ICON -->
            <Border x:Name="IconContainer"
                    Width="44"
                    Height="44"
                    CornerRadius="14"
                    Background="#F6ECE7"
                    VerticalAlignment="Center">

                <Image x:Name="imgIcon"
                       Width="22"
                       Height="22"
                       Stretch="Uniform"/>
            </Border>

            <!-- TEXT -->
            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtAmenityName"
                           Text="Wifi"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#342B28"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="txtAmenityDescription"
                           Margin="0,4,0,0"
                           Text="Fast internet access"
                           FontSize="11"
                           Foreground="#8E7F79"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- CHECK -->
            <Border x:Name="SelectionBadge"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="#F2E6E1"
                    VerticalAlignment="Center">

                <TextBlock x:Name="txtCheck"
                           Text="✓"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Border>

        </Grid>

    </Border>

</UserControl>
<UserControl x:Class="GUI_WPF.UserControls.Cards.AttractionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="768"
             Height="111">

    <Border x:Name="RootBorder"
            Background="#FFFCFA"
            BorderBrush="#EFE2DB"
            BorderThickness="1"
            CornerRadius="24"
            Padding="18,14">

        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Color="#D8C5BD"
                              Opacity="0.12"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT INFO -->
            <StackPanel VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📍" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtAttractionName"
                               Text="Gyeongbokgung Palace"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#342B28"/>
                </StackPanel>

                <TextBlock x:Name="txtAddress"
                           Margin="24,8,0,0"
                           Text="161 Sajik-ro, Jongno-gu, Seoul"
                           FontSize="12"
                           Foreground="#8B7E79"
                           TextWrapping="Wrap"/>

                <Border Margin="24,10,0,0"
                        HorizontalAlignment="Left"
                        Background="#EEF7F2"
                        Padding="10,5"
                        CornerRadius="999">
                    <TextBlock x:Name="txtArea"
                               Text="Jongno"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#3F7E69"/>
                </Border>
            </StackPanel>

            <!-- DISTANCE -->
            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Width="110"
                    Height="58"
                    Background="#F9F4F1"
                    CornerRadius="18"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Distance" FontSize="11" Foreground="#8B7E79" HorizontalAlignment="Center"/>
                    <TextBox x:Name="txtDistance"
                             Margin="0,4,0,0"
                             Text="1.2"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#3B302B"
                             HorizontalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Width="80"
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="txtDistance_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- WALK -->
            <Border Grid.Column="2"
                    Margin="12,0,0,0"
                    Width="110"
                    Height="58"
                    Background="#F7F1FF"
                    CornerRadius="18"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Walk" FontSize="11" Foreground="#8B7E79" HorizontalAlignment="Center"/>
                    <TextBox x:Name="txtWalk"
                             Margin="0,4,0,0"
                             Text="12"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#6A52A3"
                             HorizontalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Width="80"
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="txtWalk_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- DRIVE -->
            <Border Grid.Column="3"
                    Margin="12,0,0,0"
                    Width="110"
                    Height="58"
                    Background="#FFF3EA"
                    CornerRadius="18"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Drive" FontSize="11" Foreground="#8B7E79" HorizontalAlignment="Center"/>
                    <TextBox x:Name="txtDrive"
                             Margin="0,4,0,0"
                             Text="5"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#D97706"
                             HorizontalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Width="80"
                             PreviewTextInput="NumberValidationTextBox"
                             TextChanged="txtDrive_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- REMOVE -->
            <Button x:Name="btnRemove"
                    Grid.Column="4"
                    Width="42"
                    Height="42"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Background="#FFF1F1"
                    BorderBrush="#FFD7D7"
                    BorderThickness="1"
                    Click="btnRemove_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <TextBlock Text="✕"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#D14343"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Border>
</UserControl>
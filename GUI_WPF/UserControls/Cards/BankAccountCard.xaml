<UserControl x:Class="GUI_WPF.UserControls.Cards.BankAccountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="442"
             Width="457">

    <!-- ROOT -->
    <Border x:Name="RootBorder"
            Background="#AAFFFFFF"
            CornerRadius="32"
            Padding="26"
            Margin="0,0,20,20">

        <Border.Effect>

            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.06"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================= -->
            <!-- TOP -->
            <!-- ============================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BANK -->
                <StackPanel>

                    <TextBlock x:Name="txtBankName"
                               Text="Korea Development Bank"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#3A3131"/>

                    <TextBlock Text="Bank Account"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#B0A4A4"/>

                </StackPanel>

                <!-- STATUS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <!-- PRIMARY -->
                    <Border x:Name="PrimaryChip"
                            Background="#FFF6E7"
                            CornerRadius="14"
                            Padding="12,5"
                            Margin="0,0,10,0">

                        <TextBlock x:Name="txtPrimary"
                                   Text="Primary"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#D29B22"/>

                    </Border>

                    <!-- VERIFIED -->
                    <Border x:Name="VerifiedChip"
                            Background="#E8F8F0"
                            CornerRadius="14"
                            Padding="12,5">

                        <TextBlock x:Name="txtVerified"
                                   Text="Verified"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#47A87B"/>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- ============================================= -->
            <!-- BODY -->
            <!-- ============================================= -->

            <Grid Grid.Row="1"
                  Margin="0,28,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ACCOUNT NUMBER -->
                <Border Background="#FFF8F4"
                        CornerRadius="24"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Account Number"
                                   FontSize="11"
                                   Foreground="#B0A4A4"/>

                        <TextBlock x:Name="txtAccountNumber"
                                   Text="**** **** **** 2038"
                                   Margin="0,10,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#3A3131"
                                   />

                    </StackPanel>

                </Border>

                <!-- HOLDER -->
                <Border Grid.Row="1"
                        Background="#FFF8F4"
                        CornerRadius="24"
                        Padding="18"
                        Margin="0,14,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Account Holder"
                                       FontSize="11"
                                       Foreground="#B0A4A4"/>

                            <TextBlock x:Name="txtHolder"
                                       Text="Sophia Kim"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#3A3131"/>

                        </StackPanel>

                        <!-- ACTIVE -->
                        <Border x:Name="ActiveChip"
                                Grid.Column="1"
                                Background="#EEF3FF"
                                CornerRadius="14"
                                Padding="12,5"
                                VerticalAlignment="Center">

                            <TextBlock x:Name="txtActive"
                                       Text="Active"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6484D6"/>

                        </Border>

                    </Grid>

                </Border>

                <!-- CREATED -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="6,18,0,0">

                    <TextBlock Text="Added on "
                               FontSize="12"
                               Foreground="#B0A4A4"/>

                    <TextBlock x:Name="txtCreatedDate"
                               Text="14 Feb 2025"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#8B7D7D"/>

                </StackPanel>

            </Grid>

            <!-- ============================================= -->
            <!-- FOOTER -->
            <!-- ============================================= -->

            <Grid Grid.Row="2"
                  Margin="0,26,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BANK ICON -->
                <TextBlock x:Name="txtBankIcon"
                           Text="🏦"
                           FontSize="20"
                           VerticalAlignment="Center"/>

                <!-- ACTIONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <!-- EDIT -->
                    <Button x:Name="btnEdit"
                            Content="Edit"
                            Width="90"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="btnEdit_Click"
                            Style="{StaticResource OutlineButtonStyle}"/>

                    <!-- REMOVE -->
                    <Button x:Name="btnRemove"
                            Content="Remove"
                            Width="100"
                            Height="42"
                            Click="btnRemove_Click"
                            Style="{StaticResource DangerButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>
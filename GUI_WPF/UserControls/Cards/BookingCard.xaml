<UserControl x:Class="GUI_WPF.UserControls.Cards.BookingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430">

    <Border Style="{StaticResource HoverCardStyle}"
            Padding="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="txtBookingCode"
                               Style="{StaticResource CardTitleStyle}"
                               Text="BK-000001"/>

                    <TextBlock x:Name="txtBookingDate"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="15 Sep 2026"/>
                </StackPanel>

                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        Padding="12,6"
                        CornerRadius="12">

                    <TextBlock x:Name="txtStatus"
                               Style="{StaticResource ChipTextStyle}"
                               Text="Confirmed"/>
                </Border>

            </Grid>

            <!-- GUEST -->

            <Grid Grid.Row="1"
                  Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        ClipToBounds="True">

                    <Image x:Name="imgGuest"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtGuestName"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold"
                               Text="John Smith"/>

                    <TextBlock x:Name="txtGuestEmail"
                               Style="{StaticResource CaptionStyle}"
                               Text="john@gmail.com"/>
                </StackPanel>

            </Grid>

            <!-- LISTING -->

            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Style="{StaticResource SoftPanelStyle}"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="Listing"
                               Style="{StaticResource CaptionStyle}"/>

                    <TextBlock x:Name="txtListing"
                               Margin="0,4,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold"
                               Text="Luxury Apartment"/>

                    <TextBlock x:Name="txtDates"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="01 Sep → 05 Sep"/>

                    <TextBlock x:Name="txtGuests"
                               Margin="0,4,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="2 Guests"/>

                </StackPanel>

            </Border>

            <!-- PRICE -->

            <Grid Grid.Row="3"
                  Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Total Amount"
                               Style="{StaticResource CaptionStyle}"/>

                    <TextBlock x:Name="txtPrice"
                               Margin="0,4,0,0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource MintBrush}"
                               Text="$450"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Guests"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="txtGuestCount"
                               Margin="0,4,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold"
                               Text="2"/>
                </StackPanel>

            </Grid>

            <!-- ACTIONS -->

            <Grid Grid.Row="4"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnOpen"
                        Content="View Details"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="btnOpen_Click"/>

                <Button x:Name="btnConfirm"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Confirm"
                        Style="{StaticResource SuccessButtonStyle}"
                        Click="btnConfirm_Click"/>

                <Button x:Name="btnCheckIn"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="Check-In"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btnCheckIn_Click"/>

                <Button x:Name="btnMore"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Content="⋯"
                        Width="44"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btnMore_Click">

                    <Button.ContextMenu>

                        <ContextMenu>

                            <MenuItem Header="Check-Out"
                                      Click="miCheckOut_Click"/>

                            <MenuItem Header="Cancel Booking"
                                      Click="miCancel_Click"/>

                        </ContextMenu>

                    </Button.ContextMenu>

                </Button>

            </Grid>

        </Grid>

    </Border>

</UserControl>
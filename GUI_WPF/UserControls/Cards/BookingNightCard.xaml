<UserControl x:Class="GUI_WPF.UserControls.Cards.BookingNightCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource SoftPanelStyle}"
            Margin="0,0,0,10"
            Padding="14">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- DATE -->

            <Border Width="56"
                    Height="56"
                    CornerRadius="16"
                    Background="#F7F4F1">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="txtDay"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="18"/>

                    <TextBlock x:Name="txtMonth"
                               HorizontalAlignment="Center"
                               FontSize="10"
                               Foreground="#8D8D8D"
                               Text="SEP"/>

                </StackPanel>

            </Border>

            <!-- CONTENT -->

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtDate"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="SemiBold"
                           Text="18 Sep 2026"/>

                <TextBlock x:Name="txtPolicy"
                           Margin="0,4,0,0"
                           Style="{StaticResource CaptionStyle}"
                           Text="Flexible"/>

            </StackPanel>

            <!-- PRICE -->

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtPrice"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#059669"
                           Text="$120"/>

                <Border x:Name="RefundBadge"
                        Margin="0,6,0,0"
                        Padding="10,4"
                        CornerRadius="10"
                        Background="#DCFCE7"
                        HorizontalAlignment="Right">

                    <TextBlock x:Name="txtRefundStatus"
                               Style="{StaticResource ChipTextStyle}"
                               Text="Available"/>
                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
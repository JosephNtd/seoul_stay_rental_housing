<UserControl x:Class="GUI_WPF.UserControls.Cards.CalendarDayCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="95"
             Height="125">

    <Border x:Name="RootBorder"
            Background="#FFFFFF"
            BorderBrush="#EEE4DE"
            BorderThickness="1"
            CornerRadius="22"
            Cursor="Hand"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave">

        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="0"
                              Color="#D7C7C1"
                              Opacity="0.10"/>
        </Border.Effect>

        <Grid Margin="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DAY NAME -->

                <TextBlock x:Name="txtDayName"
                           Text="MON"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#93857F"
                           VerticalAlignment="Center"/>

                <!-- HOLIDAY -->

                <Border x:Name="HolidayBadge"
                        Grid.Column="1"
                        Width="10"
                        Height="10"
                        CornerRadius="5"
                        Background="#FF6B6B"
                        Visibility="Collapsed"/>
            </Grid>

            <!-- ================================================= -->
            <!-- DATE -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtDayNumber"
                           Text="18"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#322925"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="txtMonth"
                           Margin="0,4,0,0"
                           Text="SEP"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#9B8D87"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ================================================= -->
            <!-- STATUS -->
            <!-- ================================================= -->

            <Border x:Name="StatusBadge"
                    Grid.Row="2"
                    Height="26"
                    CornerRadius="13"
                    Background="#EAF8EE">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="StatusDot"
                             Width="7"
                             Height="7"
                             Fill="#2EAD67"
                             Margin="0,0,6,0"/>

                    <TextBlock x:Name="txtAvailability"
                               Text="Available"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#238553"/>
                </StackPanel>
            </Border>

            <!-- ================================================= -->
            <!-- SELECTED OVERLAY -->
            <!-- ================================================= -->

            <Border x:Name="SelectedBorder"
                    BorderBrush="#8C5B5D"
                    BorderThickness="2.2"
                    CornerRadius="22"
                    Visibility="Collapsed"/>

        </Grid>

    </Border>

</UserControl>
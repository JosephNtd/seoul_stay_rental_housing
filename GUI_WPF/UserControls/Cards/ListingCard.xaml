<UserControl x:Class="GUI_WPF.UserControls.Cards.ListingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="330"
             Height="Auto"
             MinHeight="520">
    <Border Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#D9C8C1" Opacity="0.20"/>
        </Border.Effect>
        <Border x:Name="RootBorder"
                Background="#FFFCFA"
                CornerRadius="28"
                BorderBrush="#F1E7E2"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ClipToBounds="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#D9C8C1" Opacity="0.18"/>
            </Border.Effect>

            <Grid>

                <!-- ========================= -->
                <!-- MAIN LAYOUT -->
                <!-- ========================= -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="7.288"/>
                    <RowDefinition Height="212.712"/>
                    <RowDefinition Height="105*"/>
                    <RowDefinition Height="43*"/>
                </Grid.RowDefinitions>


                <!-- COVER IMAGE -->


                <Grid ClipToBounds="True" Grid.RowSpan="2">

                    <Border CornerRadius="28,28,0,0"
                    Background="#EFE8E4"
                    ClipToBounds="True">

                        <Image x:Name="imgThumbnail"
                        Stretch="UniformToFill"/>
                    </Border>

                    <!-- DARK OVERLAY -->

                    <Border Background="#22000000"
                    CornerRadius="28,28,0,0"/>

                    <!-- STATUS -->

                    <Border x:Name="StatusBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16"
                    Padding="14,6"
                    CornerRadius="999"
                    Background="#E8F6ED">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                             Height="8"
                             Fill="#28A745"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                            <TextBlock x:Name="txtStatus"
                               Text="Active"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#208B52"/>
                        </StackPanel>
                    </Border>

                    <!-- QUICK ACTION -->

                    <Button x:Name="btnMore"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="16"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnMore_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="#AAFFFFFF"
                                CornerRadius="20">

                                    <TextBlock Text="⋮"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#40342F"/>
                                </Border>

                            </ControlTemplate>
                        </Button.Template>

                        <Button.ContextMenu>

                            <ContextMenu>

                                <MenuItem x:Name="miEdit"
                                  Header="Edit Listing"
                                  Click="miEdit_Click"/>

                                <MenuItem x:Name="miManagePricing"
                                  Header="Manage Pricing"
                                  Click="miManagePricing_Click"/>

                                <MenuItem x:Name="miManageAvailability"
                                  Header="Manage Availability"
                                  Click="miManageAvailability_Click"/>

                                <Separator/>

                                <MenuItem x:Name="miDelete"
                                  Header="Delete Listing"
                                  Foreground="#C62828"
                                  Click="miDelete_Click"/>

                            </ContextMenu>

                        </Button.ContextMenu>
                    </Button>

                    <!-- PRICE -->

                    <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="18"
                    Background="#FDF9F6"
                    CornerRadius="20"
                    Padding="16,10">

                        <StackPanel>

                            <TextBlock x:Name="txtPrice"
                               Text="$180"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#352C28"/>

                            <TextBlock Text="per night"
                               FontSize="12"
                               Foreground="#8B7E79"/>
                        </StackPanel>
                    </Border>

                </Grid>


                <!-- CONTENT -->


                <Grid Grid.Row="2"
              Margin="22,18,22,18" Grid.RowSpan="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE -->

                    <TextBlock x:Name="txtTitle"
                       Text="Luxury Nordic Apartment"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2E2724"
                       TextTrimming="CharacterEllipsis"/>

                    <!-- TYPE + AREA -->

                    <StackPanel Grid.Row="1"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">

                        <Border Background="#F7EDEA"
                        Padding="12,5"
                        CornerRadius="999">

                            <TextBlock x:Name="txtItemType"
                               Text="Apartment"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#7B5455"/>
                        </Border>

                        <Border Background="#EEF7F3"
                        Padding="12,5"
                        CornerRadius="999"
                        Margin="10,0,0,0">

                            <TextBlock x:Name="txtArea"
                               Text="Gangnam"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#3E7D67"/>
                        </Border>

                    </StackPanel>

                    <!-- ADDRESS -->

                    <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        Orientation="Horizontal">

                        <TextBlock Text="📍"
                           FontSize="14"
                           Margin="0,0,8,0"/>

                        <TextBlock x:Name="txtAddress"
                           Text="Seoul, South Korea"
                           FontSize="13"
                           Foreground="#857873"
                           TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- STATS -->

                    <UniformGrid Grid.Row="3"
                         Margin="0,18,0,0"
                         Columns="4">

                        <!-- GUESTS -->

                        <Border Margin="0,0,8,0"
                        Background="#FAF5F2"
                        CornerRadius="18"
                        Padding="10">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="👥"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                                <TextBlock x:Name="txtCapacity"
                                   Text="4"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                                <TextBlock Text="Guests"
                                   FontSize="11"
                                   Foreground="#8B7E79"
                                   HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- BEDROOMS -->

                        <Border Margin="0,0,8,0"
                        Background="#FAF5F2"
                        CornerRadius="18"
                        Padding="10">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="🛏"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                                <TextBlock x:Name="txtBedrooms"
                                   Text="2"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                                <TextBlock Text="Bedrooms"
                                   FontSize="11"
                                   Foreground="#8B7E79"
                                   HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- BEDS -->

                        <Border Margin="0,0,8,0"
                        Background="#FAF5F2"
                        CornerRadius="18"
                        Padding="10">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="🛌"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                                <TextBlock x:Name="txtBeds"
                                   Text="3"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                                <TextBlock Text="Beds"
                                   FontSize="11"
                                   Foreground="#8B7E79"
                                   HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- BATHROOMS -->

                        <Border Background="#FAF5F2"
                        CornerRadius="18"
                        Padding="10">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="🛁"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                                <TextBlock x:Name="txtBathrooms"
                                   Text="2"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                                <TextBlock Text="Baths"
                                   FontSize="11"
                                   Foreground="#8B7E79"
                                   HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- FOOTER -->

                    <Grid Grid.Row="4"
                  Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- HOST -->

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="34"
                             Height="34"
                             Fill="#EAD6D0"/>

                            <StackPanel Margin="10,0,0,0">

                                <TextBlock x:Name="txtHost"
                                   Text="John Doe"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#3A302C"/>

                                <TextBlock Text="Host"
                                   FontSize="11"
                                   Foreground="#948883"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- VIEW BTN -->

                        <Button x:Name="btnOpen"
                        Grid.Column="1"
                        Width="110"
                        Height="42"
                        Content="Open"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Cursor="Hand"
                        BorderThickness="0"
                        Click="btnOpen_Click">

                            <Button.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">

                                    <GradientStop Color="#7B5455"
                                          Offset="0"/>

                                    <GradientStop Color="#9B7071"
                                          Offset="1"/>

                                </LinearGradientBrush>

                            </Button.Background>

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18">

                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </Grid>

                </Grid>

            </Grid>

        </Border>
    </Border>
    

</UserControl>
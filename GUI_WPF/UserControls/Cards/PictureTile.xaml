<UserControl x:Class="GUI_WPF.UserControls.Cards.PictureTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="240"
             Height="260">

    <Border x:Name="RootBorder"
            Background="#FFFDFC"
            BorderBrush="#EFE3DD"
            BorderThickness="1"
            CornerRadius="28">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Color="#D9C6BE"
                              Opacity="0.14"/>
        </Border.Effect>

        <Grid>

            
            <!-- IMAGE -->
            

            <Border CornerRadius="28"
                    ClipToBounds="True">

                <Image x:Name="imgPicture"
                       Stretch="UniformToFill"/>
            </Border>

            
            <!-- TOP OVERLAY -->
            

            <Grid VerticalAlignment="Top"
                  Height="72">

                <Border CornerRadius="28,28,0,0">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                            <GradientStop Color="#8A000000"
                                          Offset="0"/>

                            <GradientStop Color="#00000000"
                                          Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                </Border>

                <Grid Margin="16,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- COVER -->

                    <Border x:Name="CoverBadge"
                            Background="#FFF4DF"
                            Padding="12,6"
                            CornerRadius="999"
                            Visibility="Collapsed">

                        <TextBlock Text="Cover"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#C67A00"/>
                    </Border>

                    <!-- ORDER -->

                    <Border Grid.Column="1"
                            Width="34"
                            Height="34"
                            Background="#AAFFFFFF"
                            CornerRadius="17">

                        <TextBlock x:Name="txtOrder"
                                   Text="1"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#2F2622"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>

            </Grid>

            
            <!-- BOTTOM OVERLAY -->
            

            <Grid VerticalAlignment="Bottom"
                  Height="92">

                <Border CornerRadius="0,0,28,28">

                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,1"
                                             EndPoint="0,0">

                            <GradientStop Color="#C4000000"
                                          Offset="0"/>

                            <GradientStop Color="#00000000"
                                          Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                </Border>

                <Grid Margin="16,0,16,16"
                      VerticalAlignment="Bottom">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILE -->

                    <StackPanel VerticalAlignment="Bottom">

                        <TextBlock x:Name="txtFileName"
                                   Text="living-room.jpg"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="txtPictureStatus"
                                   Margin="0,4,0,0"
                                   Text="Saved picture"
                                   FontSize="11"
                                   Foreground="#E9DCD7"/>
                    </StackPanel>

                    <!-- ACTIONS -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">

                        <!-- SET COVER -->

                        <Button x:Name="btnSetCover"
                                Width="38"
                                Height="38"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="btnSetCover_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="#AAFFFFFF"
                                            CornerRadius="14">

                                        <TextBlock Text="★"
                                                   FontSize="15"
                                                   Foreground="#5A4A45"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                        <!-- DELETE -->

                        <Button x:Name="btnDelete"
                                Width="38"
                                Height="38"
                                Cursor="Hand"
                                Click="btnDelete_Click">

                            <Button.Template>

                                <ControlTemplate TargetType="Button">

                                    <Border Background="#FFFFF2F2"
                                            CornerRadius="14">

                                        <TextBlock Text="🗑"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                </ControlTemplate>

                            </Button.Template>

                        </Button>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Border>

</UserControl>
<UserControl x:Class="GUI_WPF.UserControls.Cards.PriceEditorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="520"
             Height="720">

    <Border Background="#FFFDFC"
            BorderBrush="#EADFD8"
            BorderThickness="1"
            CornerRadius="32">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="0"
                              Color="#CDB8AF"
                              Opacity="0.18"/>
        </Border.Effect>

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Edit Nightly Price"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F2622"/>

                    <TextBlock x:Name="txtSelectedDate"
                               Margin="0,8,0,0"
                               Text="Tuesday, September 18 2025"
                               FontSize="14"
                               Foreground="#8A7D77"/>
                </StackPanel>

                <!-- CLOSE -->

                <Button x:Name="btnClose"
                        Grid.Column="1"
                        Width="42"
                        Height="42"
                        Cursor="Hand"
                        Click="btnClose_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="#F7EEEA"
                                    CornerRadius="16">

                                <TextBlock Text="✕"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#6A5852"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

            <!-- ================================================= -->
            <!-- CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,28,0,28">

                <StackPanel>

                    <!-- ========================================= -->
                    <!-- PRICE -->
                    <!-- ========================================= -->

                    <Border Background="#FAF5F2"
                            CornerRadius="24"
                            Padding="24">

                        <StackPanel>

                            <TextBlock Text="Nightly Price"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#342B28"/>

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="18"
                                        Background="#F1E5DF">

                                    <TextBlock Text="$"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#7C5A58"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBox x:Name="txtPrice"
                                         Grid.Column="1"
                                         Margin="16,0,0,0"
                                         Height="56"
                                         FontSize="26"
                                         FontWeight="Bold"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#2E2623"
                                         VerticalContentAlignment="Center"/>

                            </Grid>

                            <TextBlock Margin="0,14,0,0"
                                       Text="This price will be used for this selected date."
                                       FontSize="12"
                                       Foreground="#938781"/>
                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- POLICY -->
                    <!-- ========================================= -->

                    <Border Margin="0,24,0,0"
                            Background="#FAF5F2"
                            CornerRadius="24"
                            Padding="24">

                        <StackPanel>

                            <TextBlock Text="Cancellation Policy"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#342B28"/>

                            <ComboBox x:Name="cbPolicies"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0,18,0,0"
                                      Height="54"
                                      FontSize="14"
                                      SelectedValuePath="ID">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- POLICY DETAILS -->

                            <Border Margin="0,20,0,0"
                                    Background="#FFFDFB"
                                    BorderBrush="#EFE3DD"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="18">

                                <StackPanel>

                                    <TextBlock Text="Platform Commission"
                                               FontSize="12"
                                               Foreground="#8F837D"/>

                                    <TextBlock x:Name="txtCommission"
                                               Margin="0,6,0,0"
                                               Text="15%"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#7A5958"/>

                                    <Separator Margin="0,18"/>

                                    <TextBlock Text="Refund Rules"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#352C29"/>

                                    <ItemsControl x:Name="icRefundRules"
                                                  Margin="0,14,0,0">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border Margin="0,0,0,10"
                                                        Background="#F8F2EE"
                                                        CornerRadius="14"
                                                        Padding="14,12">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Rule}"
                                                                   FontSize="12"
                                                                   Foreground="#594D48"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Penalty}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#B45309"/>
                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Border>

                    <!-- ========================================= -->
                    <!-- QUICK ACTIONS -->
                    <!-- ========================================= -->

                    <Border Margin="0,24,0,0"
                            Background="#F7F0EC"
                            CornerRadius="24"
                            Padding="22">

                        <StackPanel>

                            <TextBlock Text="Quick Price Presets"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#352C29"/>

                            <UniformGrid Margin="0,18,0,0"
                                         Columns="3">

                                <Button x:Name="btnPresetLow"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,0,10,0"
                                        Height="44"
                                        Content="$80"
                                        Click="btnPresetLow_Click"/>

                                <Button x:Name="btnPresetMedium"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,0,10,0"
                                        Height="44"
                                        Content="$120"
                                        Click="btnPresetMedium_Click"/>

                                <Button x:Name="btnPresetHigh"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Height="44"
                                        Content="$200"
                                        Click="btnPresetHigh_Click"/>

                            </UniformGrid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DELETE -->

                <Button x:Name="btnRemovePrice"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="Remove Price"
                        Cursor="Hand"
                        Click="btnRemovePrice_Click">
                </Button>

                <!-- CANCEL -->

                <Button x:Name="btnCancel"
                        Style="{StaticResource OutlineButtonStyle}"
                        Grid.Column="1"
                        Width="120"
                        Height="54"
                        Margin="14,0,0,0"
                        Content="Cancel"
                        Cursor="Hand"
                        Background="#F4ECE8"
                        Foreground="#544641"
                        BorderThickness="0"
                        Click="btnCancel_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="18">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

                <!-- SAVE -->

                <Button x:Name="btnSave"
                        Grid.Column="2"
                        Width="150"
                        Height="54"
                        Margin="14,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Save Price"
                        Cursor="Hand"
                        Click="btnSave_Click">

                </Button>

            </Grid>

        </Grid>

    </Border>

</UserControl>
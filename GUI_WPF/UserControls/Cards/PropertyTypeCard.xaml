 <UserControl x:Class="GUI_WPF.UserControls.Cards.PropertyTypeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="340"
             Width="300">

    <!-- ===================================================== -->
    <!-- ROOT -->
    <!-- ===================================================== -->

    <Border x:Name="RootCard"
            Background="#AAFFFFFF"
            CornerRadius="32"
            Padding="24"
            Margin="0,0,24,24">

        <Border.Effect>

            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="0"
                              Opacity="0.08"/>

        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel>

                <!-- ICON -->
                <Border Width="88"
                        Height="88"
                        Background="#FFF0F0"
                        CornerRadius="44"
                        HorizontalAlignment="Center">

                    <Grid>

                        <Image x:Name="imgIcon"
                               Stretch="Uniform"
                               Margin="18"/>

                        <TextBlock x:Name="txtFallbackEmoji"
                                   Text="🏠"
                                   FontSize="38"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <!-- NAME -->
                <TextBlock x:Name="txtName"
                           Text="Apartment"
                           Margin="0,24,0,0"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#3A3131"/>

                <!-- COUNT -->
                <Border Background="#FFF0F0"
                        CornerRadius="16"
                        Padding="14,6"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center">

                    <TextBlock x:Name="txtCount"
                               Text="124 Listings"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#C97D7D"/>

                </Border>

            </StackPanel>

            <!-- ================================================= -->
            <!-- DESCRIPTION -->
            <!-- ================================================= -->

            <TextBlock x:Name="txtDescription"
                       Grid.Row="1"
                       Margin="0,24,0,0"
                       Text="A self-contained housing unit occupying part of a building."
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       FontSize="14"
                       LineHeight="24"
                       Foreground="#8B7D7D"
                       TextTrimming="CharacterEllipsis"/>

            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <Grid Grid.Row="2"
                  Margin="0,22,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- EDIT -->
                <Button x:Name="btnEdit"
                        Content="Edit"
                        Height="44"
                        Margin="0,0,8,0"
                        Click="btnEdit_Click"
                        Style="{StaticResource OutlineButtonStyle}"/>

                <!-- PREVIEW -->
                <Button x:Name="btnPreview"
                        Grid.Column="1"
                        Content="Preview"
                        Height="44"
                        Margin="8,0,0,0"
                        Click="btnPreview_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>

<UserControl x:Class="GUI_WPF.UserControls.Cards.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI_WPF.UserControls.Cards"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="320">
    <Border x:Name="RootCard" Style="{StaticResource StatCardStyle}" Cursor="Hand">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <!-- HOVER ANIMATION -->
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <!-- CONTENT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- TOP -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- TITLE -->
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource CardTitleStyle}"/>
                <!-- ICON -->
                <Border Grid.Column="1" Width="44" Height="44" Background="#FFF0F0" CornerRadius="22">
                    <TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <!-- VALUE -->
            <TextBlock Grid.Row="1" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource StatNumberStyle}" VerticalAlignment="Center" Margin="0,18,0,0"/>
            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- TREND CHIP -->
                <Border Background="{Binding TrendBackground, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="999" Padding="10,4">
                    <TextBlock Text="{Binding Trend, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TrendForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Border>
                <!-- DESCRIPTION -->
                <TextBlock Grid.Column="1" Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

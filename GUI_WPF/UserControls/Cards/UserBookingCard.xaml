<UserControl x:Class="GUI_WPF.UserControls.Cards.UserBookingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="387"
             Width="520">

    <!-- ROOT -->
    <Border x:Name="RootBorder"
            Background="#AAFFFFFF"
            CornerRadius="30"
            Padding="24"
            Margin="0,0,0,20">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.06"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================= -->
            <!-- HEADER -->
            <!-- ============================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AVATAR -->
                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="#FFF0F0">

                    <TextBlock x:Name="txtInitials"
                               Text="SK"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#C97D7D"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- INFO -->
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0">

                    <TextBlock x:Name="txtProperty"
                               Text="Luxury Han River Apartment"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#3A3131"/>

                    <TextBlock x:Name="txtArea"
                               Text="Gangnam • Seoul"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="#8B7D7D"/>

                </StackPanel>

                <!-- STATUS -->
                <Border x:Name="StatusChip"
                        Grid.Column="2"
                        Background="#E8F8F0"
                        CornerRadius="16"
                        Padding="14,7"
                        VerticalAlignment="Top">

                    <TextBlock x:Name="txtStatus"
                               Text="Confirmed"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#47A87B"/>

                </Border>

            </Grid>

            <!-- ============================================= -->
            <!-- BODY -->
            <!-- ============================================= -->

            <Grid Grid.Row="1"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel>

                    <!-- DATES -->
                    <Border Background="#FFF8F4"
                            CornerRadius="22"
                            Padding="16"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock Text="Stay Dates"
                                       FontSize="11"
                                       Foreground="#B0A4A4"/>

                            <TextBlock x:Name="txtDates"
                                       Text="12 Jun - 18 Jun 2025"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#3A3131"/>

                        </StackPanel>

                    </Border>

                    <!-- GUEST -->
                    <Border Background="#FFF8F4"
                            CornerRadius="22"
                            Padding="16">

                        <StackPanel>

                            <TextBlock Text="Guest"
                                       FontSize="11"
                                       Foreground="#B0A4A4"/>

                            <TextBlock x:Name="txtGuest"
                                       Text="Sophia Kim"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#3A3131"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0">

                    <!-- PRICE -->
                    <Border Background="#FFF8F4"
                            CornerRadius="22"
                            Padding="16"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock Text="Final Price"
                                       FontSize="11"
                                       Foreground="#B0A4A4"/>

                            <TextBlock x:Name="txtPrice"
                                       Text="$1,280"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#3A3131"/>

                        </StackPanel>

                    </Border>

                    <!-- DETAILS -->
                    <Border Background="#FFF8F4"
                            CornerRadius="22"
                            Padding="16">

                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,26,0">

                                <TextBlock Text="Guests"
                                           FontSize="11"
                                           Foreground="#B0A4A4"/>

                                <TextBlock x:Name="txtGuests"
                                           Text="4"
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#3A3131"/>

                            </StackPanel>

                            <StackPanel>

                                <TextBlock Text="Nights"
                                           FontSize="11"
                                           Foreground="#B0A4A4"/>

                                <TextBlock x:Name="txtNights"
                                           Text="6"
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#3A3131"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- ============================================= -->
            <!-- FOOTER -->
            <!-- ============================================= -->

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BOOKING ID -->
                <TextBlock x:Name="txtBookingID"
                           Text="#BK-20913"
                           FontSize="12"
                           Foreground="#B0A4A4"
                           VerticalAlignment="Center"/>

                <!-- ACTIONS -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <!-- VIEW -->
                    <Button x:Name="btnView"
                            Content="View"
                            Width="90"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="btnView_Click"
                            Style="{StaticResource OutlineButtonStyle}"/>

                    <!-- ACTION -->
                    <Button x:Name="btnAction"
                            Content="Manage"
                            Width="110"
                            Height="42"
                            Click="btnAction_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>
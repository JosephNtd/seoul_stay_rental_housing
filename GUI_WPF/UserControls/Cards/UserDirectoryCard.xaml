<UserControl x:Class="GUI_WPF.UserControls.Cards.UserDirectoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="135"
             Width="320">

    <Border x:Name="RootBorder"
            Background="#AAFFFFFF"
            CornerRadius="26"
            Padding="18"
            Margin="0,0,0,18"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">

        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="0"
                              Opacity="0.06"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- AVATAR -->
            <Border Width="58"
                    Height="58"
                    CornerRadius="29"
                    Background="#FFF0F0"
                    VerticalAlignment="Top">

                <TextBlock x:Name="txtInitials"
                           Text="SK"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#C97D7D"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <!-- INFO -->
            <StackPanel Grid.Column="1">

                <TextBlock x:Name="txtName"
                           Text="Sophia Kim"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#3A3131"/>

                <TextBlock x:Name="txtEmail"
                           Text="sophia@seoulstay.com"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#8B7D7D"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0">

                    <!-- ROLE -->
                    <Border x:Name="RoleChip"
                            Background="#FCECEC"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,8,0">

                        <TextBlock x:Name="txtRole"
                                   Text="Host"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#C97D7D"/>

                    </Border>

                    <!-- STATUS -->
                    <Border x:Name="StatusChip"
                            Background="#E8F8F0"
                            CornerRadius="12"
                            Padding="10,4">

                        <TextBlock x:Name="txtStatus"
                                   Text="Active"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#47A87B"/>

                    </Border>

                </StackPanel>

            </StackPanel>

            <!-- RIGHT -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Right">

                <TextBlock x:Name="txtCountry"
                           Text="KR"
                           FontSize="12"
                           Foreground="#B0A4A4"
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="txtBookings"
                           Text="128 bookings"
                           Margin="0,34,0,0"
                           FontSize="11"
                           Foreground="#B0A4A4"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>

<UserControl x:Class="GUI_WPF.UserControls.Cards.UserStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="213"
             Width="281">

    <!-- ROOT -->
    <Border x:Name="RootBorder"
            Background="#AAFFFFFF"
            CornerRadius="30"
            Padding="24"
            Margin="0,0,18,18">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.06"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================= -->
            <!-- TOP -->
            <!-- ============================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE -->
                <TextBlock x:Name="txtTitle"
                           Text="Total Revenue"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#8B7D7D"
                           VerticalAlignment="Center"/>

                <!-- ICON -->
                <Border x:Name="IconBubble"
                        Grid.Column="1"
                        Width="46"
                        Height="46"
                        Background="#FFF0F0"
                        CornerRadius="23">

                    <TextBlock x:Name="txtIcon"
                               Text="💰"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

            </Grid>

            <!-- ============================================= -->
            <!-- VALUE -->
            <!-- ============================================= -->

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">

                <TextBlock x:Name="txtValue"
                           Text="$84,290"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#3A3131"/>

                <TextBlock x:Name="txtSubtitle"
                           Text="Across all completed bookings"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#B0A4A4"/>

            </StackPanel>

            <!-- ============================================= -->
            <!-- FOOTER -->
            <!-- ============================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TREND CHIP -->
                <Border x:Name="TrendChip"
                        Background="#E8F8F0"
                        CornerRadius="14"
                        Padding="10,5">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock x:Name="txtTrendIcon"
                                   Text="↗"
                                   FontSize="11"
                                   Margin="0,0,4,0"
                                   Foreground="#47A87B"/>

                        <TextBlock x:Name="txtTrend"
                                   Text="+12.4%"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#47A87B"/>

                    </StackPanel>

                </Border>

                <!-- PERIOD -->
                <TextBlock x:Name="txtPeriod"
                           Grid.Column="1"
                           Text="vs last month"
                           Margin="12,0,0,0"
                           FontSize="11"
                           Foreground="#B0A4A4"
                           VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>

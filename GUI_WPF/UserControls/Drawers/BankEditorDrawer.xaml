<UserControl x:Class="GUI_WPF.UserControls.Drawers.BankEditorDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="480">

    
    <!-- ROOT -->
    

    <Grid>

        
        <!-- RIGHT DRAWER -->
        

        <Border Width="480"
                HorizontalAlignment="Right"
                Background="#FFF8F4">

            <Border.Effect>

                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="-4"
                                  Opacity="0.14"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========================================= -->
                <!-- HEADER -->
                <!-- ========================================= -->

                <Border Background="#AAFFFFFF"
                        Padding="28"
                        BorderBrush="#EFE2E2"
                        BorderThickness="0,0,0,1">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT -->
                        <StackPanel>

                            <TextBlock x:Name="txtDrawerTitle"
                                       Text="Edit Bank Account"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#3A3131"/>

                            <TextBlock Text="Manage payout and withdrawal account"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="#9B8C8C"/>

                        </StackPanel>

                        <!-- CLOSE -->
                        <Button x:Name="btnCloseDrawer"
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                Content="✕"
                                Click="btnCloseDrawer_Click"
                                Style="{StaticResource OutlineButtonStyle}"/>

                    </Grid>

                </Border>

                <!-- ========================================= -->
                <!-- BODY -->
                <!-- ========================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="28">

                        <!-- ================================= -->
                        <!-- BANK CARD -->
                        <!-- ================================= -->

                        <Border Background="#AAFFFFFF"
                                CornerRadius="30"
                                Padding="28"
                                Margin="0,0,0,24">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.04"/>

                            </Border.Effect>

                            <StackPanel>

                                <!-- TITLE -->
                                <TextBlock Text="Bank Information"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#3A3131"/>

                                <!-- BANK LOGO -->
                                <Grid Margin="0,28,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ICON -->
                                    <Border Width="84"
                                            Height="84"
                                            Background="#FDECEC"
                                            CornerRadius="24">

                                        <TextBlock Text="🏦"
                                                   FontSize="34"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- INFO -->
                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Secure Banking"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#3A3131"/>

                                        <TextBlock Text="Encrypted payout destination"
                                                   Margin="0,6,0,0"
                                                   Foreground="#8B7D7D"/>

                                    </StackPanel>

                                </Grid>

                                <!-- BANK NAME -->
                                <StackPanel Margin="0,30,0,0">

                                    <TextBlock Text="Bank Name"
                                               FontWeight="SemiBold"
                                               Foreground="#5F5555"/>

                                    <TextBox x:Name="txtBankName"
                                             Height="54"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource SoftTextBoxStyle}"/>

                                </StackPanel>

                                <!-- ACCOUNT HOLDER -->
                                <StackPanel Margin="0,22,0,0">

                                    <TextBlock Text="Account Holder"
                                               FontWeight="SemiBold"
                                               Foreground="#5F5555"/>

                                    <TextBox x:Name="txtAccountHolder"
                                             Height="54"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource SoftTextBoxStyle}"/>

                                </StackPanel>

                                <!-- ACCOUNT NUMBER -->
                                <StackPanel Margin="0,22,0,0">

                                    <TextBlock Text="Account Number"
                                               FontWeight="SemiBold"
                                               Foreground="#5F5555"/>

                                    <TextBox x:Name="txtAccountNumber"
                                             Height="54"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource SoftTextBoxStyle}"/>

                                </StackPanel>

                                <!-- BANK CODE -->
                                <StackPanel Margin="0,22,0,0">

                                    <TextBlock Text="Swift / Bank Code"
                                               FontWeight="SemiBold"
                                               Foreground="#5F5555"/>

                                    <TextBox x:Name="txtSwiftCode"
                                             Height="54"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource SoftTextBoxStyle}"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <!-- ================================= -->
                        <!-- SETTINGS -->
                        <!-- ================================= -->

                        <Border Background="#AAFFFFFF"
                                CornerRadius="30"
                                Padding="28"
                                Margin="0,0,0,24">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.04"/>

                            </Border.Effect>

                            <StackPanel>

                                <!-- TITLE -->
                                <TextBlock Text="Account Settings"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#3A3131"/>

                                <!-- PRIMARY -->
                                <Border Background="#FFF8F4"
                                        CornerRadius="22"
                                        Padding="20"
                                        Margin="0,28,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="Primary Payout Account"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="#3A3131"/>

                                            <TextBlock Text="Main destination for booking payouts"
                                                       Margin="0,6,0,0"
                                                       Foreground="#8B7D7D"/>

                                        </StackPanel>

                                        <CheckBox x:Name="chkPrimary"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                                <!-- VERIFIED -->
                                <Border Background="#FFF8F4"
                                        CornerRadius="22"
                                        Padding="20"
                                        Margin="0,16,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="Verified Account"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="#3A3131"/>

                                            <TextBlock Text="Bank ownership confirmed"
                                                       Margin="0,6,0,0"
                                                       Foreground="#8B7D7D"/>

                                        </StackPanel>

                                        <CheckBox x:Name="chkVerified"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                                <!-- ACTIVE -->
                                <Border Background="#FFF8F4"
                                        CornerRadius="22"
                                        Padding="20"
                                        Margin="0,16,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="Active Account"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="#3A3131"/>

                                            <TextBlock Text="Can receive payments and withdrawals"
                                                       Margin="0,6,0,0"
                                                       Foreground="#8B7D7D"/>

                                        </StackPanel>

                                        <CheckBox x:Name="chkActive"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsChecked="True"/>

                                    </Grid>

                                </Border>

                            </StackPanel>

                        </Border>

                        <!-- ================================= -->
                        <!-- SECURITY -->
                        <!-- ================================= -->

                        <Border Background="#FFF4E9"
                                CornerRadius="28"
                                Padding="24">

                            <StackPanel>

                                <TextBlock Text="Security Notice"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#C56A11"/>

                                <TextBlock Text="Banking information is encrypted and stored securely. Any modification may require identity verification."
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#8B7D7D"
                                           LineHeight="24"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

                <!-- ========================================= -->
                <!-- FOOTER -->
                <!-- ========================================= -->

                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        Padding="24"
                        BorderBrush="#EFE2E2"
                        BorderThickness="0,1,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- INFO -->
                        <TextBlock Text="Changes affect payout configuration"
                                   VerticalAlignment="Center"
                                   Foreground="#9B8C8C"/>

                        <!-- CANCEL -->
                        <Button x:Name="btnCancel"
                                Grid.Column="1"
                                Content="Cancel"
                                Width="120"
                                Height="50"
                                Margin="0,0,14,0"
                                Click="btnCancel_Click"
                                Style="{StaticResource OutlineButtonStyle}" RenderTransformOrigin="0.887,0.465"/>

                        <!-- SAVE -->
                        <Button x:Name="btnSave"
                                Grid.Column="2"
                                Content="Save Account"
                                Width="160"
                                Height="50"
                                Click="btnSave_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>
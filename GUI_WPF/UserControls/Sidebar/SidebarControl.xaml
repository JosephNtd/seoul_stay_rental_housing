<UserControl x:Class="GUI_WPF.UserControls.Sidebar.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GUI_WPF.UserControls.Sidebar"
             mc:Ignorable="d" 
             d:DesignWidth="280"
             Background="Transparent">
    <UserControl.Resources>
        <!-- EXPANDER STYLE -->
        <Style x:Key="SidebarExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- HEADER -->
                            <ToggleButton 
                                x:Name="HeaderSite" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                IsChecked="{Binding IsExpanded,
                          RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="18" Padding="18,14" Width="230">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- TITLE -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗂" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtCatalog" Text="Catalog" Margin="14,0,0,0" Style="{StaticResource SidebarTextStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- ARROW -->
                                        <TextBlock x:Name="Arrow" Grid.Column="1" Text="⌄" FontSize="16" Foreground="#8B7D7D" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <!-- CONTENT -->
                            <Border x:Name="ExpandSite" Visibility="Collapsed" Margin="18,6,0,0">
                                <StackPanel>
                                    <Button 
                                        x:Name="btnLocationCatalog"
                                        Click="btnLocationCatalog_Click"
                                        Style="{StaticResource SidebarButtonStyle}" 
                                        Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📍" FontSize="15"/>
                                            <TextBlock Text="Areas | Attractions" Margin="12,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button 
                                        x:Name="btnPropertyTypes"
                                        Click="btnPropertyTypes_Click"
                                        Style="{StaticResource SidebarButtonStyle}"
                                        Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏠" FontSize="15"/>
                                            <TextBlock Text="Property Types" Margin="12,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button 
                                        x:Name="btnServices"
                                        Click="btnServices_Click"
                                        Style="{StaticResource SidebarButtonStyle}" 
                                        Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛎" FontSize="15"/>
                                            <TextBlock Text="Services" Margin="12,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button 
                                        x:Name="btnTransactions"
                                        Click="btnTransactions_Click"
                                        Style="{StaticResource SidebarButtonStyle}" 
                                        Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💳" FontSize="15"/>
                                            <TextBlock Text="Transactions" Margin="12,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- TRIGGERS -->
                        <ControlTemplate.Triggers>
                            <!-- EXPAND -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow" Property="Text" Value="⌃"/>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#FFF0F0"/>
                            </Trigger>
                            <!-- HOVER -->
                            <Trigger SourceName="HeaderSite"  Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#FFF6F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- ROOT -->
    <Border Background="#66FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.05"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- LOGO -->
            
            <StackPanel Margin="8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="txtLogo"
                                   Text="SEOUL STAY"
                                   FontSize="30"/>

                        <TextBlock x:Name="txtSubLogo"
                                    Text="Smart City Platform"/>
                    </StackPanel>

                    <Button x:Name="btnToggleSidebar"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Click="BtnToggleSidebar_Click"
                            Content="☰"/>
                </Grid>
                
            </StackPanel>
            <!-- NAVIGATION -->
            <StackPanel Grid.Row="1" Margin="0,40,0,0">
                <!-- DASHBOARD -->
                <Button 
                    x:Name="btnDashboard"
                    Style="{StaticResource SidebarButtonStyle}" 
                    Background="#FFF0F0" 
                    Foreground="#D89C9D"
                    Click="btnDashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="18"/>

                        <TextBlock x:Name="txtDashboard"
                                   Text="Dashboard"
                                   Margin="14,0,0,0"
                                   Style="{StaticResource SidebarTextStyle}"/>
                    </StackPanel>
                </Button>
                <!-- CATALOG -->
                <Expander x:Name="expCatalog" Style="{StaticResource SidebarExpanderStyle}"/>
                <!-- USERS -->
                <Button 
                    x:Name="btnUsers"
                    Click="btnUsers_Click"
                    Style="{StaticResource SidebarButtonStyle}">
                    <StackPanel Orientation="Horizontal" >
                        <TextBlock Text="👥" FontSize="18"/>
                        <TextBlock x:Name="txtUsers" Text="Users" Margin="14,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                    </StackPanel>
                </Button>
                <!-- LISTINGS -->
                <Button 
                    x:Name="btnListings"
                    Click="btnListings_Click"
                    Style="{StaticResource SidebarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏡" FontSize="18"/>
                        <TextBlock x:Name="txtListings" Text="Listings" Margin="14,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                    </StackPanel>
                </Button>
                <!-- BOOKINGS -->
                <Button 
                    x:Name="btnBookings"
                    Click="btnBookings_Click"
                    Style="{StaticResource SidebarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📅" FontSize="18"/>
                        <TextBlock x:Name="txtBookings" Text="Bookings" Margin="14,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                    </StackPanel>
                </Button>
                <!-- REPORTS -->
                <Button 
                    x:Name="btnReports"
                    Click="btnReports_Click"
                    Style="{StaticResource SidebarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="18"/>
                        <TextBlock x:Name="txtReports" Text="Reports" Margin="14,0,0,0" Style="{StaticResource SidebarTextStyle}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- PROFILE -->
            <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock 
                        x:Name="txtAdminName"
                        Text="Administrator" 
                        Style="{StaticResource LabelStyle}"/>
                    <TextBlock 
                        x:Name="txtAdminRole"
                        Text="admin@seoulstay.com" 
                        Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="GUI_WPF.UserControls.Timeline.TransactionTimelineItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="130"
             Width="520">

    <!-- ROOT -->
    <Border x:Name="RootBorder"
            Background="#AAFFFFFF"
            CornerRadius="28"
            Padding="20"
            Margin="0,0,0,18">

        <Border.Effect>

            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.05"/>

        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================= -->
            <!-- ICON -->
            <!-- ============================================= -->

            <Border x:Name="IconBubble"
                    Width="58"
                    Height="58"
                    Background="#EEF3FF"
                    CornerRadius="29"
                    VerticalAlignment="Center">

                <TextBlock x:Name="txtIcon"
                           Text="💳"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <!-- ============================================= -->
            <!-- CONTENT -->
            <!-- ============================================= -->

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">

                <!-- TITLE -->
                <TextBlock x:Name="txtTitle"
                           Text="Booking Payment"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#3A3131"/>

                <!-- SUB -->
                <TextBlock x:Name="txtSubtitle"
                           Text="Luxury Han River Apartment"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#8B7D7D"/>

                <!-- META -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <!-- DATE -->
                    <TextBlock x:Name="txtDate"
                               Text="14 Feb 2025 • 10:28 AM"
                               FontSize="11"
                               Foreground="#B0A4A4"/>

                    <!-- DOT -->
                    <TextBlock Text=" • "
                               FontSize="11"
                               Foreground="#D0C4C4"/>

                    <!-- TYPE -->
                    <TextBlock x:Name="txtType"
                               Text="Credit Card"
                               FontSize="11"
                               Foreground="#B0A4A4"/>

                </StackPanel>

            </StackPanel>

            <!-- ============================================= -->
            <!-- RIGHT -->
            <!-- ============================================= -->

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                <!-- AMOUNT -->
                <TextBlock x:Name="txtAmount"
                           Text="+ $1,280"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#47A87B"
                           HorizontalAlignment="Right"/>

                <!-- STATUS -->
                <Border x:Name="StatusChip"
                        Background="#E8F8F0"
                        CornerRadius="14"
                        Padding="12,5"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right">

                    <TextBlock x:Name="txtStatus"
                               Text="Completed"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#47A87B"/>

                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>

@model DTO.DTO_Invoice
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment - @Model.InvoiceCode</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(135deg, #FFF8F4 0%, #F7E8E8 50%, #E8F5EE 100%);
                min-height: 100vh;
                padding: 20px;
            }
            .container {
                max-width: 480px;
                margin: 0 auto;
            }
            .card {
                background: white;
                border-radius: 24px;
                padding: 28px;
                margin-bottom: 16px;
                box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            }
            .header {
                text-align: center;
                margin-bottom: 8px;
            }
            .hotel-name {
                font-size: 22px;
                font-weight: 700;
                color: #D89C9D;
                margin-bottom: 4px;
            }
            .invoice-code {
                font-size: 13px;
                color: #8B7D7D;
                letter-spacing: 1px;
            }
            .status-badge {
                display: inline-block;
                padding: 6px 16px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
                margin-top: 12px;
            }
            .status-pending {
                background: #FEF3C7;
                color: #D97706;
            }
            .status-paid {
                background: #D1FAE5;
                color: #059669;
            }
            .status-cancelled {
                background: #FEE2E2;
                color: #DC2626;
            }
            .divider {
                height: 1px;
                background: #F0DEDE;
                margin: 20px 0;
            }
            .section-title {
                font-size: 11px;
                font-weight: 600;
                color: #8B7D7D;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 12px;
            }
            .info-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 8px 0;
            }
            .info-label {
                font-size: 13px;
                color: #6B7280;
            }
            .info-value {
                font-size: 13px;
                font-weight: 600;
                color: #3A3131;
                text-align: right;
                max-width: 60%;
                word-break: break-word;
            }
            .total-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 14px 0;
                border-top: 2px solid #F0DEDE;
                margin-top: 8px;
            }
            .total-label {
                font-size: 15px;
                font-weight: 700;
                color: #3A3131;
            }
            .total-value {
                font-size: 20px;
                font-weight: 700;
                color: #D89C9D;
            }
            .btn-group {
                display: flex;
                gap: 12px;
                margin-top: 8px;
            }
            .btn {
                flex: 1;
                padding: 16px;
                border: none;
                border-radius: 16px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
            }
            .btn:active {
                transform: scale(0.97);
            }
            .btn-confirm {
                background: linear-gradient(135deg, #C1ECDA 0%, #7DD3A8 100%);
                color: #065F46;
            }
            .btn-confirm:hover {
                background: linear-gradient(135deg, #A7F3D0 0%, #6EE7B7 100%);
            }
            .btn-cancel {
                background: #FFF4F4;
                color: #DC2626;
                border: 1.5px solid #FCA5A5;
            }
            .btn-cancel:hover {
                background: #FEE2E2;
            }
            .btn-disabled {
                opacity: 0.5;
                cursor: not-allowed;
                pointer-events: none;
            }
            .error-msg {
                background: #FEF2F2;
                border: 1px solid #FCA5A5;
                color: #DC2626;
                padding: 12px 16px;
                border-radius: 12px;
                font-size: 13px;
                margin-bottom: 16px;
                text-align: center;
            }
            .footer-text {
                text-align: center;
                font-size: 11px;
                color: #9CA3AF;
                margin-top: 20px;
                line-height: 1.6;
            }
    </style>
</head>
<body>
    <div class="container">

        @if (TempData["Error"] != null)
        {
            <div class="error-msg">@TempData["Error"]</div>
        }

        <!-- HEADER CARD -->
        <div class="card">
            <div class="header">
                <div class="hotel-name">@Model.HotelName</div>
                <div class="invoice-code">@Model.InvoiceCode</div>
                <span class="status-badge @(Model.IsPending ? "status-pending" : Model.IsPaid ? "status-paid" : "status-cancelled")">
                    @Model.StatusDisplay
                </span>
            </div>
        </div>

        <!-- BOOKING INFO -->
        <div class="card">
            <div class="section-title">Booking Information</div>
            <div class="info-row">
                <span class="info-label">Booking Code</span>
                <span class="info-value">@Model.BookingCode</span>
            </div>
            <div class="info-row">
                <span class="info-label">Booking Date</span>
                <span class="info-value">@Model.BookingDateDisplay</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-value">@Model.BookingStatusDisplay</span>
            </div>
        </div>

        <!-- GUEST INFO -->
        <div class="card">
            <div class="section-title">Guest</div>
            <div class="info-row">
                <span class="info-label">Name</span>
                <span class="info-value">@Model.GuestFullName</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email</span>
                <span class="info-value">@(Model.GuestEmail ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="info-label">Phone</span>
                <span class="info-value">@(Model.GuestPhone ?? "—")</span>
            </div>
        </div>

        <!-- STAY INFO -->
        <div class="card">
            <div class="section-title">Stay Details</div>
            <div class="info-row">
                <span class="info-label">Listing</span>
                <span class="info-value">@Model.ListingTitle</span>
            </div>
            <div class="info-row">
                <span class="info-label">Type</span>
                <span class="info-value">@Model.ListingType</span>
            </div>
            <div class="info-row">
                <span class="info-label">Check-in</span>
                <span class="info-value">@Model.CheckInDisplay</span>
            </div>
            <div class="info-row">
                <span class="info-label">Check-out</span>
                <span class="info-value">@Model.CheckOutDisplay</span>
            </div>
            <div class="info-row">
                <span class="info-label">Nights</span>
                <span class="info-value">@Model.NightDisplay</span>
            </div>
            <div class="info-row">
                <span class="info-label">Guests</span>
                <span class="info-value">@Model.GuestDisplay</span>
            </div>
        </div>

        <!-- PRICING SUMMARY -->
        <div class="card">
            <div class="section-title">Payment Summary</div>
            <div class="info-row">
                <span class="info-label">Subtotal (Nights)</span>
                <span class="info-value">@Model.BaseAmountDisplay</span>
            </div>

            @if (Model.AddonAmount > 0)
            {
                <div class="info-row">
                    <span class="info-label">Add-on Services</span>
                    <span class="info-value">@Model.AddonAmountDisplay</span>
                </div>
            }

            @if (Model.CleaningFee > 0)
            {
                <div class="info-row">
                    <span class="info-label">Cleaning Fee</span>
                    <span class="info-value">@Model.CleaningFeeDisplay</span>
                </div>
            }

            @if (Model.ServiceFee > 0)
            {
                <div class="info-row">
                    <span class="info-label">Service Fee</span>
                    <span class="info-value">@Model.ServiceFeeDisplay</span>
                </div>
            }

            @if (Model.TaxAmount > 0)
            {
                <div class="info-row">
                    <span class="info-label">Tax</span>
                    <span class="info-value">@Model.TaxDisplay</span>
                </div>
            }

            @if (Model.HasDiscount)
            {
                <div class="info-row">
                    <span class="info-label">Discount (@Model.CouponDisplay)</span>
                    <span class="info-value" style="color: #059669;">@Model.DiscountDisplay</span>
                </div>
            }

            <div class="total-row">
                <span class="total-label">Total Amount</span>
                <span class="total-value">@Model.TotalAmountDisplay</span>
            </div>
        </div>

        <!-- ACTION BUTTONS -->
        @if (Model.IsPending)
        {
            <div class="card">
                <div class="section-title">Confirm Payment</div>
                <p style="font-size: 13px; color: #6B7280; margin-bottom: 16px; line-height: 1.5;">
                    This is a <strong>payment simulation</strong> for demonstration purposes.
                    No real money will be charged.
                </p>
                <div class="btn-group">
                    <form method="post" action="/payment/@Model.InvoiceID/confirm" style="flex:1; display:flex;">
                        <button type="submit" class="btn btn-confirm" style="flex:1;">
                            ✓ Confirm Payment
                        </button>
                    </form>
                    <form method="post" action="/payment/@Model.InvoiceID/cancel" style="flex:1; display:flex;">
                        <button type="submit" class="btn btn-cancel" style="flex:1;">
                            ✕ Cancel
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card" style="text-align: center;">
                <p style="font-size: 14px; color: #6B7280;">
                    This invoice has been <strong>@Model.StatusDisplay.ToLower()</strong>.
                </p>
                @if (Model.IsPaid)
                {
                    <p style="font-size: 12px; color: #059669; margin-top: 8px;">
                        Paid on @Model.PaidDateDisplay
                    </p>
                }
            </div>
        }

        <!-- FOOTER -->
        <div class="footer-text">
            <p>@Model.HotelName</p>
            <p>@Model.HotelAddress</p>
            <p>This is a simulated payment page for academic purposes only.</p>
        </div>
    </div>
</body>
</html>
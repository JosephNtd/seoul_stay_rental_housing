@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Invoice Not Found</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #FFF8F4;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            background: white;
            border-radius: 24px;
            padding: 48px 36px;
            text-align: center;
            max-width: 400px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        }
        .icon { font-size: 48px; margin-bottom: 16px; }
        .title { font-size: 20px; font-weight: 700; color: #3A3131; margin-bottom: 8px; }
        .desc { font-size: 14px; color: #6B7280; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">🔍</div>
        <div class="title">Invoice Not Found</div>
        <p class="desc">The invoice you are looking for does not exist or the link is invalid.</p>
    </div>
</body>
</html>
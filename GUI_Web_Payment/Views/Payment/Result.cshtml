@{
    Layout = null;
    string status = ViewBag.Status;
    long invoiceId = ViewBag.InvoiceId;
    bool isPaid = status == "Paid";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Payment @(isPaid ? "Successful" : "Cancelled")</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #FFF8F4 0%, @(isPaid ? "#E8F5EE" : "#FEF2F2") 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .result-card {
            background: white;
            border-radius: 28px;
            padding: 48px 36px;
            text-align: center;
            max-width: 400px;
            width: 100%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
        }
        .icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 36px;
        }
        .icon-success {
            background: #D1FAE5;
            color: #059669;
        }
        .icon-cancel {
            background: #FEE2E2;
            color: #DC2626;
        }
        .title {
            font-size: 22px;
            font-weight: 700;
            color: #3A3131;
            margin-bottom: 8px;
        }
        .subtitle {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.6;
            margin-bottom: 24px;
        }
        .info-box {
            background: #F9FAFB;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 24px;
        }
        .info-box p {
            font-size: 13px;
            color: #6B7280;
            margin: 4px 0;
        }
        .info-box strong {
            color: #3A3131;
        }
        .btn-back {
            display: inline-block;
            padding: 14px 32px;
            background: linear-gradient(135deg, #E7B6B6, #D89C9D);
            color: white;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: opacity 0.2s;
        }
        .btn-back:hover { opacity: 0.85; }
        .note {
            font-size: 11px;
            color: #9CA3AF;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="result-card">
        <div class="icon @(isPaid ? "icon-success" : "icon-cancel")">
            @(isPaid ? "✓" : "✕")
        </div>
        <div class="title">
            @(isPaid ? "Payment Successful" : "Payment Cancelled")
        </div>
        <div class="subtitle">
            @if (isPaid)
            {
                <span>Your payment has been confirmed. The booking is now active.</span>
            }
            else
            {
                <span>The payment has been cancelled. You can try again later.</span>
            }
        </div>
        <div class="info-box">
            <p>Invoice: <strong>INV-@invoiceId.ToString("000000")</strong></p>
            <p>Status: <strong>@status</strong></p>
        </div>
        <a href="/payment/@invoiceId" class="btn-back">View Invoice</a>
        <p class="note">You can close this page now.<br/>The desktop application has been notified.</p>
    </div>
</body>
</html>
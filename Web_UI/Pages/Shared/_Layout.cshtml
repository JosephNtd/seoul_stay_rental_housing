<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web_UI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web_UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="fixed top-0 w-full z-50 bg-white/70 backdrop-blur-md border-b border-rose-100/20 font-['Plus_Jakarta_Sans'] antialiased shadow-[0_8px_30px_rgb(244,194,194,0.08)]">
            <div class="flex justify-between items-center px-6 py-4 max-w-screen-2xl mx-auto">
                <div class="flex items-center gap-8">
                    <span class="text-xl font-bold tracking-tight text-zinc-900">LuxeStay</span>
                    <div class="hidden md:flex items-center gap-6">
                        <a class="text-rose-400 font-semibold text-label-md" asp-page="/Index">Explore</a>
                        <a class="text-zinc-500 hover:bg-rose-50/50 transition-colors px-3 py-1 rounded-full text-label-md" href="#">Saved</a>
                        <a class="text-zinc-500 hover:bg-rose-50/50 transition-colors px-3 py-1 rounded-full text-label-md" asp-page="/MyBooking">Bookings</a>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button class="p-2 text-zinc-500 hover:bg-rose-50/50 rounded-full transition-colors">
                        <span class="material-symbols-outlined">notifications</span>
                    </button>
                    <button class="flex items-center gap-2 p-1.5 pr-3 bg-white border border-rose-100/30 rounded-full hover:shadow-sm transition-all">
                        <div class="w-8 h-8 rounded-full bg-primary-container flex items-center justify-center overflow-hidden">
                            <span class="material-symbols-outlined text-on-primary-container text-[20px]">person</span>
                        </div>
                        <span class="text-label-md text-on-surface">Profile</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Web_UI - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>